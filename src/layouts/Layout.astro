---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import interFontURL from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import spaceGroteskFontURL from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific social share image, as a site-root path. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  contentType?: 'website' | 'article';
  publishedTime?: Date | string;
  noindex?: boolean;
  preconnectWeather?: boolean;
}

const {
  title = "Tomfoolery",
  description = "Tom's personal hub — photos, collections, coffee, and whatever else.",
  image = "/og.png",
  imageAlt = "Tomfoolery — coffee, collections, old stories, and the sky over Texas.",
  imageWidth = 1200,
  imageHeight = 630,
  contentType = 'website',
  publishedTime,
  noindex = false,
  preconnectWeather = false,
} = Astro.props;

// Absolute URLs for canonical + Open Graph. `Astro.site` comes from the `site`
// key in astro.config.mjs — if that's ever unset these fall back to relative
// paths rather than throwing at build time.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageURL = new URL(image, Astro.site ?? Astro.url.origin);

const primaryNavItems = [
  { href: '/now', label: 'now' },
  { href: '/coffee', label: 'coffee' },
  { href: '/pokemon', label: 'pokémon' },
  { href: '/art', label: 'art' },
  { href: '/archive', label: 'archive' },
  { href: '/game', label: 'play' },
  { href: '/about', label: 'about' },
] as const;

const mobileDirectItems = primaryNavItems.filter(
  ({ href }) => href === '/now' || href === '/game',
);
const mobileIndexItems = primaryNavItems.filter(
  ({ href }) => href !== '/now' && href !== '/game',
);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
const currentMobileIndexItem = mobileIndexItems.find(({ href }) => isCurrent(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={contentType} />
    <meta property="og:site_name" content="Tomfoolery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {
      contentType === 'article' && publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime instanceof Date
            ? publishedTime.toISOString()
            : publishedTime}
        />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#FAF6EE" />

    <link
      rel="preload"
      href={interFontURL}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={spaceGroteskFontURL}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {preconnectWeather && <link rel="preconnect" href="https://api.open-meteo.com" />}
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-canvas text-ink font-body antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="glass-nav">
      <div class="site-header">
        <a
          href="/"
          class="site-wordmark font-display font-semibold tracking-tight text-lg flicker-hover"
          aria-current={currentPath === '/' ? 'page' : undefined}
        >
          Tom<span class="gradient-text">foolery</span>
        </a>

        <nav class="site-nav site-nav--desktop" aria-label="Primary">
          {primaryNavItems.map((item) => (
            <a
              href={item.href}
              class="site-nav__link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="site-nav-mobile">
          <nav class="site-nav site-nav--mobile-direct" aria-label="Primary">
            {mobileDirectItems.map((item) => (
              <a
                href={item.href}
                class="site-nav__link"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <details
            class="site-index"
            data-has-current={currentMobileIndexItem ? 'true' : undefined}
          >
            <summary
              aria-label={currentMobileIndexItem
                ? `Site index, current page ${currentMobileIndexItem.label}`
                : 'Site index'}
            >index</summary>
            <nav class="site-index__panel" aria-label="More pages">
              {mobileIndexItems.map((item) => (
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="max-w-6xl mx-auto px-6 py-8 md:py-9 relative z-10" transition:name="main-content" transition:animate="fade">
      <slot />
    </main>
    <footer class="max-w-6xl mx-auto px-6 py-12 relative z-10">
      <nav aria-label="Footer" class="footer-nav flex flex-wrap gap-x-5 gap-y-2 text-xs font-mono border-t border-line pt-6">
        <a href="/" class="hover:text-ink transition-colors" aria-current={currentPath === '/' ? 'page' : undefined}>home</a>
        {primaryNavItems.map((item) => (
          <a
            href={item.href}
            class="hover:text-ink transition-colors"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <p class="mt-5 text-xs text-muted font-mono">
        built with a little help from an AI, tended by hand
      </p>
    </footer>

    <script>
      // --- Scroll reveal (tiles/sections) ---
      function setupReveal() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // --- Kinetic type: split [data-kinetic] elements into word spans ---
      function setupKineticType() {
        document.querySelectorAll('[data-kinetic]:not([data-kinetic-done])').forEach((el) => {
          const text = el.textContent ?? '';
          const words = text.split(/(\s+)/);
          el.innerHTML = words
            .map((w, i) =>
              w.trim() === ''
                ? w
                : `<span class="kinetic-word" style="--i:${i}">${w}</span>`
            )
            .join('');
          el.setAttribute('data-kinetic-done', 'true');
        });

        const kineticEls = document.querySelectorAll('.kinetic-word:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          kineticEls.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        kineticEls.forEach((el) => io.observe(el));
      }

      function initAll() {
        setupReveal();
        setupKineticType();
      }

      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>

---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** Page-specific social share image, as a site-root path. */
  image?: string;
}

const {
  title = "Tomfoolery",
  description = "Tom's personal hub — photos, collections, coffee, and whatever else.",
  image = "/images/og-card.png",
} = Astro.props;

// Absolute URLs for canonical + Open Graph. `Astro.site` comes from the `site`
// key in astro.config.mjs — if that's ever unset these fall back to relative
// paths rather than throwing at build time.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageURL = new URL(image, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter. Without these, sharing any page anywhere
         produced a bare link with no title card or image. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tomfoolery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tomfoolery — a personal site" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="theme-color" content="#FAF6EE" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-canvas text-ink font-body antialiased">
    <header class="glass-nav">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="font-display font-semibold tracking-tight text-lg flicker-hover">
          Tom<span class="gradient-text">foolery</span>
        </a>
        <nav class="flex items-center gap-4 sm:gap-5 text-sm text-muted font-mono">
          <a href="/now" class="hover:text-ink transition-colors">now</a>
          <a href="/coffee" class="hidden sm:inline hover:text-ink transition-colors">coffee</a>
          <a href="/archive" class="hidden sm:inline hover:text-ink transition-colors">archive</a>
          <a href="/game" class="hover:text-ink transition-colors">play</a>
          <a href="/about" class="hover:text-ink transition-colors">about</a>
        </nav>
      </div>
    </header>
    <main class="max-w-6xl mx-auto px-6 py-10 relative z-10" transition:name="main-content" transition:animate="fade">
      <slot />
    </main>
    <footer class="max-w-6xl mx-auto px-6 py-12 relative z-10">
      <nav class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted font-mono border-t border-line pt-6">
        <a href="/" class="hover:text-ink transition-colors">home</a>
        <a href="/now" class="hover:text-ink transition-colors">now</a>
        <a href="/coffee" class="hover:text-ink transition-colors">coffee</a>
        <a href="/pokemon" class="hover:text-ink transition-colors">pok&eacute;mon</a>
        <a href="/art" class="hover:text-ink transition-colors">art</a>
        <a href="/archive" class="hover:text-ink transition-colors">archive</a>
        <a href="/game" class="hover:text-ink transition-colors">moon lander</a>
        <a href="/about" class="hover:text-ink transition-colors">about</a>
      </nav>
      <p class="mt-5 text-xs text-muted font-mono">
        built with a little help from an AI, tended by hand
      </p>
    </footer>

    <script>
      // --- Scroll reveal (tiles/sections) ---
      function setupReveal() {
        const els = document.querySelectorAll('.reveal:not(.is-visible)');
        if (!('IntersectionObserver' in window) || els.length === 0) {
          document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // --- Kinetic type: split [data-kinetic] elements into word spans ---
      function setupKineticType() {
        document.querySelectorAll('[data-kinetic]:not([data-kinetic-done])').forEach((el) => {
          const text = el.textContent ?? '';
          const words = text.split(/(\s+)/);
          el.innerHTML = words
            .map((w, i) =>
              w.trim() === ''
                ? w
                : `<span class="kinetic-word" style="--i:${i}">${w}</span>`
            )
            .join('');
          el.setAttribute('data-kinetic-done', 'true');
        });

        const kineticEls = document.querySelectorAll('.kinetic-word:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          kineticEls.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        kineticEls.forEach((el) => io.observe(el));
      }

      function initAll() {
        setupReveal();
        setupKineticType();
      }

      document.addEventListener('astro:page-load', initAll);
    </script>
  </body>
</html>

<script>
  const LATTE_POURS = [
    {
      path: 'M90 76c12-10 32-10 44 0-13 8-31 8-44 0Zm8 0c7-5 21-5 28 0-8 5-20 5-28 0Zm14-11v20',
      caption: 'A little art before the first sip.',
    },
    {
      path: 'M112 65c-15 2-18 14 0 21 18-7 15-19 0-21Zm-9 5c-6 4-4 10 9 13 13-3 15-9 9-13m-9-6v22',
      caption: 'Freshly poured: three-tier tulip.',
    },
    {
      path: 'M112 85c-18-7-22-17-11-20 6-2 11 3 11 7 0-4 5-9 11-7 11 3 7 13-11 20Z',
      caption: 'Freshly poured: monk’s head heart.',
    },
    {
      path: 'M112 77c-6 0-10 4-6 8 3 3 9 3 12 0 4-4 0-8-6-8Zm-11-6a2.5 2.5 0 1 0 0 .1Zm7-4a2.5 2.5 0 1 0 0 .1Zm8 0a2.5 2.5 0 1 0 0 .1Zm7 4a2.5 2.5 0 1 0 0 .1Z',
      caption: 'Freshly poured: Scout’s paw print.',
    },
  ];

  function initCabinetInteractions() {
    const pourBtn = document.querySelector<HTMLButtonElement>('[data-latte-pour]');
    const foamPath = document.querySelector<SVGPathElement>('[data-latte-foam]');
    const captionEl = document.querySelector<HTMLElement>('[data-latte-caption]');
    if (pourBtn && foamPath && captionEl && !pourBtn.dataset.bound) {
      pourBtn.dataset.bound = 'true';
      let index = 0;
      pourBtn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        index = (index + 1) % LATTE_POURS.length;
        const next = LATTE_POURS[index];
        foamPath.setAttribute('d', next.path);
        captionEl.textContent = next.caption;
      });
    }

    const holoCard = document.querySelector<HTMLElement>('[data-holo-card]');
    if (
      holoCard
      && !holoCard.dataset.bound
      && window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches
    ) {
      holoCard.dataset.bound = 'true';
      const sheen = holoCard.querySelector<HTMLElement>('.cabinet__holo-sheen');
      const svg = holoCard.querySelector<SVGSVGElement>('svg');
      holoCard.addEventListener('pointermove', (event) => {
        const rect = holoCard.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width - 0.5;
        const py = (event.clientY - rect.top) / rect.height - 0.5;
        if (svg) {
          svg.style.transform =
            `perspective(520px) rotateX(${(py * -10).toFixed(2)}deg) rotateY(${(px * 12).toFixed(2)}deg) translateY(-4px)`;
        }
        if (sheen) {
          sheen.style.opacity = '1';
          sheen.style.transform = `translate3d(${(px * 28).toFixed(1)}px, ${(py * 24).toFixed(1)}px, 0)`;
        }
      });
      holoCard.addEventListener('pointerleave', () => {
        if (svg) svg.style.transform = '';
        if (sheen) {
          sheen.style.opacity = '0';
          sheen.style.transform = 'translate3d(0, 0, 0)';
        }
      });
    }
  }

  initCabinetInteractions();
  document.addEventListener('astro:page-load', initCabinetInteractions);
</script>

<style>
  .cabinet { margin-block: clamp(3rem, 7vw, 5.5rem); padding: clamp(1.5rem, 3vw, 2.5rem); color: #f9efdc; background: #292721; border: 1px solid #292721; box-shadow: 0 24px 48px -28px rgba(24, 18, 12, 0.45); overflow: hidden; position: relative; }
  .cabinet__intro { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: .6rem 2rem; padding-bottom: 1.6rem; border-bottom: 1px solid rgba(249,239,220,.22); }
  .cabinet__intro .editorial-kicker { width: 100%; color: #e7b568; }
  .cabinet__intro h2 { max-width: 15ch; font-family: var(--font-display); font-size: clamp(2.1rem, 4.7vw, 4rem); font-weight: 560; letter-spacing: -.055em; line-height: .97; }
  .cabinet__intro p { max-width: 16rem; color: #e2d4bb; font-size: .9rem; }
  .cabinet__shelf { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cabinet__item { min-width: 0; padding: 1.3rem .95rem .45rem; position: relative; overflow: hidden; display: flex; flex-direction: column; color: inherit; border-right: 1px solid rgba(249,239,220,.22); transition: background-color 260ms ease; }
  .cabinet__item::before { height: 2px; position: absolute; top: -1px; right: .95rem; left: .95rem; content: ''; background: #e7b568; transform: scaleX(0); transform-origin: left; transition: transform 320ms cubic-bezier(.2,.7,.2,1); }
  .cabinet__item:hover::before, .cabinet__item:focus-visible::before { transform: scaleX(1); }
  .cabinet__item:first-child { padding-left: 0; }
  .cabinet__item:last-child { border-right: 0; padding-right: 0; }
  .cabinet__item:hover, .cabinet__item:focus-visible { background: rgba(255,255,255,.065); }
  .cabinet__item:focus-visible { outline: 2px solid #e7b568; outline-offset: -2px; }
  .cabinet__item-top { display: flex; align-items: center; justify-content: space-between; gap: .4rem; }
  .cabinet__number { color: #e0cba9; font-family: var(--font-mono); font-size: .6rem; letter-spacing: .1em; white-space: nowrap; }
  .cabinet__pour-btn { padding: .14rem .42rem; color: #e7b568; background: rgba(231, 181, 104, 0.12); border: 1px solid rgba(231, 181, 104, 0.35); border-radius: 999px; font-family: var(--font-mono); font-size: .56rem; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: transform 180ms ease, opacity 180ms ease; }
  .cabinet__pour-btn:hover { transform: scale(1.05); background: rgba(231, 181, 104, 0.22); }
  .cabinet__holo-sheen { position: absolute; inset: -20%; pointer-events: none; opacity: 0; background: linear-gradient(125deg, transparent 30%, rgba(255, 232, 163, 0.14) 45%, rgba(162, 228, 218, 0.16) 50%, rgba(244, 182, 210, 0.14) 55%, transparent 70%); transition: opacity 240ms ease; will-change: transform, opacity; }
  svg { width: 100%; max-height: 13rem; margin-block: .3rem .15rem; overflow: visible; filter: drop-shadow(0 12px 10px rgba(0,0,0,.18)); transition: transform 320ms cubic-bezier(.2,.7,.2,1); }
  .cabinet__item:hover svg, .cabinet__item:focus-visible svg { transform: translateY(-4px); }
  .cabinet__title { display: flex; justify-content: space-between; align-items: baseline; font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.8rem); font-weight: 580; letter-spacing: -.04em; }
  .cabinet__title span { color: #e7b568; font-family: var(--font-mono); font-size: 1rem; font-weight: 400; transition: transform 220ms ease; }
  .cabinet__item:hover .cabinet__title span { transform: translate(3px,-3px); }
  .cabinet__description { min-height: 2.6rem; color: #d4c4a9; font-size: .75rem; line-height: 1.5; }
  .cabinet__steam path { animation: steam-wisp 4.4s ease-in-out infinite; }
  .cabinet__steam path:nth-child(2) { animation-delay: -1.35s; }
  .cabinet__steam path:nth-child(3) { animation-delay: -2.7s; }
  .cabinet__back-card { transform-origin: 104px 97px; animation: card-back 6.5s ease-in-out infinite; }
  .cabinet__front-card { transform-origin: 139px 90px; animation: card-front 6.5s ease-in-out infinite; }
  .cabinet__card-glint { animation: card-glint 6.5s ease-in-out infinite; }
  .cabinet__spark { transform-origin: 204px 55px; animation: sparkle 3.8s ease-in-out infinite; }
  .cabinet__pencil { transform-origin: 182px 106px; animation: pencil 6s ease-in-out infinite; }
  .cabinet__ink-line { stroke-dasharray: 90; animation: ink-draw 6s ease-in-out infinite; }
  .cabinet__letter { transform-origin: 119px 91px; animation: letter 6.5s ease-in-out infinite; }
  @keyframes steam-wisp { 0%, 100% { transform: translateY(1px); opacity: .45; } 45% { transform: translateY(-8px); opacity: 1; } }
  @keyframes card-back { 0%, 100% { transform: rotate(-12deg); } 50% { transform: rotate(-15deg) translate(-2px,-3px); } }
  @keyframes card-front { 0%, 100% { transform: rotate(10deg); } 50% { transform: rotate(12deg) translate(2px,-4px); } }
  @keyframes card-glint { 0%, 30%, 75%, 100% { opacity: .12; } 47% { opacity: .52; } }
  @keyframes sparkle { 0%, 100% { transform: scale(.8); opacity: .65; } 50% { transform: scale(1.1); opacity: 1; } }
  @keyframes pencil { 0%, 100% { transform: rotate(27deg); } 50% { transform: rotate(22deg) translateY(-3px); } }
  @keyframes ink-draw { 0%, 8% { stroke-dashoffset: 90; } 32%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: 90; } }
  @keyframes letter { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(-8deg) translateY(-9px); } }
  @media (max-width: 760px) {
    .cabinet__shelf { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cabinet__item { border-bottom: 1px solid rgba(249,239,220,.22); }
    .cabinet__item:nth-child(2) { border-right: 0; padding-right: 0; }
    .cabinet__item:nth-child(3) { padding-left: 0; border-bottom: 0; }
    .cabinet__item:nth-child(4) { border-bottom: 0; }
  }
  @media (max-width: 430px) {
    .cabinet { padding: 1.15rem; }
    .cabinet__item { padding: 1rem .6rem .5rem; }
    .cabinet__number { font-size: .52rem; }
    svg { height: 9.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cabinet__steam path, .cabinet__back-card, .cabinet__front-card, .cabinet__card-glint, .cabinet__spark, .cabinet__pencil, .cabinet__ink-line, .cabinet__letter { animation: none; }
    .cabinet__back-card { transform: rotate(-12deg); }
    .cabinet__front-card { transform: rotate(10deg); }
    .cabinet__pencil { transform: rotate(27deg); }
    .cabinet__letter { transform: rotate(-8deg); }
  }
</style>

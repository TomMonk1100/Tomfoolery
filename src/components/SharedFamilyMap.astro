---
import { ADAM, MARK, FRED_RICHARD } from '../data/shared-family';
import { familyMapPeople, familyMapKnownCount, mapProfileUrl } from '../data/family-map';
import { browsePeople, explorerPeople, explorerGraph, preferredName, lifeYears, personBadge } from '../scripts/family/explorer';
const people=explorerPeople('family');
const graph=explorerGraph(ADAM,{ancestors:2,children:true,siblings:false,whole:false},people);
const allPeople=[...Object.values(browsePeople), ...familyMapPeople.filter(p=>p.kind==='unknown')];
const ids=new Set(allPeople.map(p=>p.id));
// Include imported-tree gaps, keeping the same stable position IDs in both views.
for(const p of Object.values(explorerPeople('family',true))) if(!ids.has(p.id)){allPeople.push(p);ids.add(p.id);}
---
<section class="shared-tree family-enhanced" data-shared-tree>
  <div class="shared-tree-intro"><p><strong>A family account, with the evidence in view.</strong> Browse known relatives without losing names to research gaps, or choose supported ancestry to follow only evidence-backed connections. Biblical, legendary and speculative royal extensions are excluded.</p></div>
  <section class="family-explorer" aria-labelledby="shared-tree-heading">
    <div class="family-map-header"><div><span class="editorial-kicker">Muncie · Stockwell · Crook</span><h2 id="shared-tree-heading" data-shared-title>Tom’s family</h2></div><span class="family-map-count" data-shared-count>{graph.nodes.length} people in view</span></div>
    <div class="family-view-bar"><fieldset><legend>View</legend><label><input type="radio" name="family-evidence" value="family" data-evidence-mode checked /> Family tree</label><label><input type="radio" name="family-evidence" value="supported" data-evidence-mode /> Supported ancestry</label></fieldset><button type="button" data-back-to-me>Back to me</button></div>
    <p class="family-view-description" data-view-description>Known relatives and recorded connections. “Family account” means the relationship still needs independent proof.</p>
    <nav class="family-breadcrumb" aria-label="Connection to Tom" data-family-breadcrumb></nav>
    <div class="family-toolbar">
      <div class="family-search-wrap"><label class="sr-only" for="shared-search">Find a relative</label><input id="shared-search" type="search" placeholder={`Search ${Object.keys(browsePeople).length} relatives…`} autocomplete="off" aria-controls="shared-results" /><div class="family-search-results" data-shared-popup hidden><p role="status" data-shared-status></p><ul id="shared-results"></ul></div></div>
      <div class="family-zoom-controls"><button type="button" data-shared-out aria-label="Zoom out">−</button><output data-shared-zoom aria-label="Zoom level">100%</output><button type="button" data-shared-in aria-label="Zoom in">+</button><button type="button" data-shared-fit>Fit view</button><button type="button" data-shared-center>Find selected person</button><button type="button" data-shared-whole>Whole tree</button><button type="button" data-shared-fullscreen>Full screen</button></div>
    </div>
    <div class="family-map-options shared-options"><fieldset><legend class="sr-only">Family branches</legend><label>Show <select data-shared-depth aria-label="Tree scope"><option value="1">1 generation</option><option value="2" selected>2 generations</option><option value="3">3 generations</option><option value="4">4 generations</option><option value="5">5 generations</option><option value="ancestors">All ancestors</option><option value="all">All people</option></select></label><label><input type="checkbox" data-shared-children checked /> Children</label><label><input type="checkbox" data-shared-siblings /> Siblings</label><label><input type="checkbox" data-show-gaps /> Show research gaps</label></fieldset><button type="button" data-compact-toggle aria-pressed="false">List view</button><button type="button" data-shared-reset>Reset</button></div>
    <div class="shared-shortcuts"><span>Start with:</span><button type="button" data-shared-focus={ADAM}>Tom</button><button type="button" data-shared-focus={MARK}>Stockwell</button><button type="button" data-shared-focus={FRED_RICHARD}>Muncie upbringing</button><a href="#family-next-steps">Next records ↓</a></div>
    <div class="family-compact" data-family-compact aria-label="Compact family view"></div>
    <div class="family-map-stage" data-shared-stage tabindex="0" aria-label="Family tree. Arrow keys pan; plus and minus zoom; Home fits the view." aria-describedby="shared-map-help"><div class="family-map-world" data-shared-world style={`width:${graph.width}px;height:${graph.height}px`}>
      <svg class="family-map-lines" data-shared-lines width={graph.width} height={graph.height} aria-hidden="true">{graph.edges.map(e=><path d={e.path} data-kind={e.kind} data-confidence={e.confidence} data-source={e.sourceKind} data-role={e.role} />)}</svg><div class="family-generation-labels" data-shared-labels aria-hidden="true">{graph.generations.map(g=><span style={`top:${g.y-14}px`}>{g.label}</span>)}</div>
      {allPeople.map(p=>{const n=graph.nodes.find(n=>n.id===p.id);return <a class="family-map-person" data-shared-person={p.id} data-person-kind={p.kind} href={p.kind==='unknown'?`#map-${p.id}`:mapProfileUrl(p.id)} hidden={!n} style={n?`left:${n.x}px;top:${n.y}px`:undefined} aria-label={`${preferredName(p.id,browsePeople)}, ${lifeYears(p.dates)}. Open person details.`}><span class="family-node-name">{preferredName(p.id,browsePeople)}</span><span class="family-node-dates">{lifeYears(p.dates)||'Dates not recorded'}</span><span class="family-node-badge" data-card-badge>{p.kind==='unknown'?'Research gap':personBadge(p.id)}</span></a>})}
    </div><span class="family-map-watermark">The family notebook</span></div>
    <div class="family-map-footer"><div class="shared-key"><span>Recorded parent</span><span class="shared-key-biological">Biological · testimony</span><span class="shared-key-raised">Raised by · testimony</span><span class="shared-key-partner">Partner</span><span class="shared-key-review">Needs proof</span></div><p id="shared-map-help">Drag to move · pinch or Ctrl + scroll to zoom · select a person for their evidence</p></div>
    <details class="shared-evidence-note"><summary>How to read the evidence</summary><p class="family-map-note">A badge describes the evidence for a connection, not proof of every fact about a person. Supported ancestry includes supported record assessments and direct family testimony; probable, disputed and unreviewed claims stop that trail. Family tree preserves the imported account with uncertainty labels. “Raised by” is distinct from biological parentage and does not imply legal adoption. Dates and aliases may remain unresolved.</p></details>
  </section>
  <noscript><p>The interactive views need JavaScript. Browse the person directory and supported trails below; each full profile preserves sources and limits.</p></noscript>
  <details class="family-fallback"><summary>Family directory · {Object.keys(browsePeople).length} people</summary><ul class="shared-directory">{Object.values(browsePeople).sort((a,b)=>a.name.localeCompare(b.name)).map(p=><li><a href={mapProfileUrl(p.id)}>{preferredName(p.id)}</a><small>{lifeYears(p.dates)} · {personBadge(p.id)}</small></li>)}</ul></details>
  <details class="family-fallback" data-map-gaps><summary>Research gaps · immediate parent positions</summary><p>Positions are stable research markers, not invented people or a count of distant generations.</p><ul class="shared-directory">{allPeople.filter(p=>p.kind==='unknown').map(p=><li id={`map-${p.id}`}><strong>{p.aliases[0]}</strong><p>No parent established in this view. Possible identities may exist in the family account.</p><a href={mapProfileUrl(p.child!)}>Child’s profile ↗</a></li>)}</ul></details>
  <dialog class="family-dialog shared-person-dialog" data-shared-dialog aria-label="Family person details"><div class="family-profiles"><div class="family-detail-header"><h2>Person details</h2><button type="button" data-shared-close aria-label="Close person details">×</button></div><article class="family-profile"><span class="editorial-kicker" data-shared-kind></span><h3 data-shared-person-name tabindex="-1"></h3><p class="family-aliases" data-shared-dates></p><div class="family-panel-tabs" role="tablist" aria-label="Person information"><button type="button" role="tab" id="person-tab-biography" aria-controls="person-panel-biography" aria-selected="true" data-panel-tab="biography">Biography</button><button type="button" role="tab" id="person-tab-connections" aria-controls="person-panel-connections" aria-selected="false" tabindex="-1" data-panel-tab="connections">Connections</button><button type="button" role="tab" id="person-tab-sources" aria-controls="person-panel-sources" aria-selected="false" tabindex="-1" data-panel-tab="sources">Sources</button></div><section role="tabpanel" id="person-panel-biography" aria-labelledby="person-tab-biography" data-panel="biography"><p class="family-aliases" data-shared-aliases></p><div data-person-biography></div><p class="shared-provenance" data-shared-provenance></p></section><section role="tabpanel" id="person-panel-connections" aria-labelledby="person-tab-connections" data-panel="connections" hidden><div data-shared-relatives></div></section><section role="tabpanel" id="person-panel-sources" aria-labelledby="person-tab-sources" data-panel="sources" hidden><div data-person-sources></div></section><button type="button" class="shared-explore" data-shared-explore>Explore their branches</button><a class="shared-profile-link" data-shared-profile href={mapProfileUrl(ADAM)}>Full profile &amp; archive ↗</a></article></div></dialog>
</section>
<script>import '../scripts/shared-family-tree';</script>

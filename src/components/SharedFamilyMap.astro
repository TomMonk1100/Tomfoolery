---
import { sharedPeople, sharedById, sharedCounts, ADAM, MARK, FRED_RICHARD, personUrl } from '../data/shared-family';
import { sharedGraph } from '../scripts/family/shared-graph';
const graph=sharedGraph(ADAM);
---
<section class="shared-tree family-enhanced" data-shared-tree>
  <div class="shared-tree-intro"><p><strong>{sharedCounts.people} people · {sharedCounts.families} families.</strong> Kevin’s Muncie & Crook tree, imported in full on 5 October 2026.</p><p>Adam (Tom) → Patrick → <strong>Mark Allen Stockwell</strong>. Gloria’s later family with Fred Richard Muncie appears alongside this line. Partner lines do not imply parentage.</p></div>
  <section class="family-explorer" aria-labelledby="shared-tree-heading">
    <div class="family-map-header"><div><span class="editorial-kicker">The wider family</span><h2 id="shared-tree-heading" data-shared-title>Tom’s family</h2></div><span class="family-map-count" data-shared-count>{graph.nodes.length} in view / 611</span></div>
    <div class="family-toolbar">
      <div class="family-search-wrap"><label class="sr-only" for="shared-search">Find anyone in the complete family tree</label><input id="shared-search" type="search" placeholder="Search all 611 people…" autocomplete="off" aria-controls="shared-results" /><div class="family-search-results" data-shared-popup hidden><p role="status" data-shared-status></p><ul id="shared-results"></ul></div></div>
      <div class="family-zoom-controls"><button type="button" data-shared-out aria-label="Zoom out">−</button><output data-shared-zoom aria-label="Zoom level">100%</output><button type="button" data-shared-in aria-label="Zoom in">+</button><button type="button" data-shared-fit>Fit view</button><button type="button" data-shared-whole>Whole tree</button><button type="button" data-shared-fullscreen>Full screen</button></div>
    </div>
    <div class="family-map-options shared-options"><fieldset><legend class="sr-only">Family branches</legend><label>Ancestors <select data-shared-depth aria-label="Ancestor generations"><option value="1">1 generation</option><option value="2" selected>2 generations</option><option value="3">3 generations</option><option value="4">4 generations</option><option value="30">All recorded</option></select></label><label><input type="checkbox" data-shared-children checked /> Children</label><label><input type="checkbox" data-shared-siblings /> Siblings</label></fieldset><button type="button" data-shared-reset>Reset</button></div>
    <div class="shared-shortcuts"><span>Start with:</span><button type="button" data-shared-focus={ADAM}>Tom</button><button type="button" data-shared-focus={MARK}>Stockwell</button><button type="button" data-shared-focus={FRED_RICHARD}>Muncie</button><a href="#ancestry-journey">Ancestry trails ↓</a><a href="#italian-research">Italian research ↓</a></div>
    <div class="family-map-stage" data-shared-stage tabindex="0" aria-label="Complete family tree. Arrow keys pan; plus and minus zoom; Home fits the view." aria-describedby="shared-map-help"><div class="family-map-world" data-shared-world style={`width:${graph.width}px;height:${graph.height}px`}>
      <svg class="family-map-lines" data-shared-lines width={graph.width} height={graph.height} aria-hidden="true">{graph.edges.map(e=><path d={e.path} data-kind={e.kind} />)}</svg><div class="family-generation-labels" data-shared-labels aria-hidden="true">{graph.generations.map(g=><span style={`top:${g.y-14}px`}>{g.label}</span>)}</div>
      {sharedPeople.map(p=>{const n=graph.nodes.find(n=>n.id===p.id);return <a class="family-map-person" data-shared-person={p.id} href={personUrl(p.id)} hidden={!n} style={n?`left:${n.x}px;top:${n.y}px`:undefined} title={p.name} aria-label={`${p.name}, ${p.dates}. Open person details.`}><span class="family-node-name">{p.id===ADAM?'Adam Muncie (Tom)':p.name}</span><span class="family-node-dates">{p.dates}</span><span class="family-node-alias">{p.id===MARK?'Tom’s grandfather':p.id===ADAM?'Starting person':p.aliases[0]||'Open profile ↗'}</span></a>})}
    </div><span class="family-map-watermark">Muncie & Crook</span></div>
    <div class="family-map-footer"><div class="shared-key"><span>Parent / child</span><span>Partners</span></div><p id="shared-map-help">Drag to move · pinch or Ctrl + scroll to zoom · arrow keys navigate cards</p></div>
    <details class="shared-evidence-note"><summary>About these connections</summary><p class="family-map-note">Connections are explicitly recorded in the family-provided tree. The original records behind its citations have not all been inspected. Biological or adoptive status is left unspecified where the tree does not state it. The separately researched Italian branches retain their confidence labels below.</p></details>
  </section>
  <details class="family-fallback"><summary>Browse every person as a list</summary><ul class="shared-directory">{sharedPeople.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(p=><li><a href={personUrl(p.id)}>{p.name}</a><small>{p.dates}</small></li>)}</ul></details>
  <dialog class="family-dialog shared-person-dialog" data-shared-dialog aria-label="Family person details"><div class="family-profiles"><div class="family-detail-header"><h2>Person details</h2><button type="button" data-shared-close aria-label="Close person details">×</button></div><article class="family-profile"><span class="editorial-kicker">Family-provided genealogy</span><h3 data-shared-person-name tabindex="-1"></h3><p class="family-aliases" data-shared-dates></p><p class="family-aliases" data-shared-aliases></p><button type="button" class="shared-explore" data-shared-explore>Explore their branches</button><a class="shared-profile-link" data-shared-profile href={personUrl(ADAM)}>Full profile, events & sources ↗</a><div data-shared-relatives></div><p class="shared-provenance">Full profiles include every recorded date, place, note and citation. Conflicting entries remain separate.</p></article></div></dialog>
</section>
<script>import '../scripts/shared-family-tree';</script>

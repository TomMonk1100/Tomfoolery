---
// The living almanac is intentionally fixed to Breckenridge for this atlas.
// Local astronomy chooses the photographic slice and drives every celestial
// reading. Open-Meteo and the ISS service progressively enhance the frame.
---

<script>
  import { installOutsideLifecycle } from '../scripts/sky/outside-controller';

  installOutsideLifecycle();
</script>

<section
  class="outside-almanac full-bleed"
  id="outside-band"
  data-condition="clear"
  data-moment="noon"
  data-tone="light"
  data-contrast="soft"
  data-focal="oak-line"
  data-plate-fallback="solar"
  data-weather="loading"
  aria-labelledby="outside-heading"
>
  <div class="outside-almanac__scene" aria-hidden="true">
    <img
      class="outside-almanac__plate"
      data-plate-slot="a"
      alt=""
      decoding="async"
      fetchpriority="high"
      loading="eager"
      draggable="false"
    />
    <img
      class="outside-almanac__plate"
      data-plate-slot="b"
      alt=""
      decoding="async"
      fetchpriority="low"
      loading="eager"
      draggable="false"
    />
    <div class="outside-almanac__reticles" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
  </div>

  <div class="outside-almanac__content">
    <header class="outside-almanac__masthead">
      <div class="outside-almanac__place">
        <span class="outside-almanac__signal live-pulse" aria-hidden="true"></span>
        <h2 id="outside-heading">Outside</h2>
        <span>Breckenridge, TX</span>
      </div>
      <p data-field="source-status">weather loading · almanac local</p>
    </header>

    <div class="outside-almanac__hero">
      <div class="outside-almanac__weather">
        <p
          class="outside-almanac__temperature"
          data-field="weather-temp"
          aria-live="polite"
        >—</p>
        <p class="outside-almanac__description" data-field="weather-desc">
          Reading the sky…
        </p>
        <p class="outside-almanac__feels">
          Feels like <span data-field="weather-feelslike">—</span>
          <span aria-hidden="true">·</span>
          H <span data-field="weather-high">—</span>
          <span aria-hidden="true">·</span>
          L <span data-field="weather-low">—</span>
        </p>
      </div>

      <div class="outside-almanac__celestial">
        <div class="outside-almanac__daylight">
          <p data-field="daylight-label">sunset in</p>
          <strong data-field="daylight-value">—</strong>
        </div>
      </div>
    </div>

    <div class="outside-almanac__ledger">
      <section
        class="outside-almanac__night-watch"
        aria-labelledby="outside-night-watch-heading"
      >
        <div class="outside-almanac__night-watch-heading">
          <h3 id="outside-night-watch-heading">Night watch</h3>
          <span>Breckenridge lunar almanac · tap Moon for telemetry</span>
        </div>

        <div class="outside-almanac__night-watch-reading">
          <button
            type="button"
            class="outside-almanac__moon-trigger"
            data-moon-trigger
            aria-label="Inspect lunar distance and send a shooting star across the chart"
            title="Tap to inspect lunar distance & wish on a shooting star"
          >
            <canvas
              data-moon-portrait
              width="200"
              height="200"
              aria-hidden="true"
            ></canvas>
          </button>
          <div>
            <p>
              <span data-field="moon-fraction">—</span>
              <span aria-hidden="true">·</span>
              <span data-field="moon-phase">—</span>
            </p>
            <span
              class="outside-almanac__moon-horizon"
              data-field="moon-horizon"
            >reading horizon</span>
            <span
              class="outside-almanac__moon-telemetry"
              data-field="moon-telemetry"
              hidden
            ></span>
          </div>
        </div>
      </section>

      <div class="outside-almanac__chart-header">
        <p>
          Sky altitude &amp; temperature
          <span data-field="temperature-range">rolling 24 hours</span>
          <em class="outside-almanac__scrub-pill" data-field="ribbon-scrub" hidden></em>
        </p>
        <ul class="outside-almanac__legend" aria-label="Chart key">
          <li>
            <span class="outside-almanac__legend-line is-sun" aria-hidden="true"></span>
            Sun
          </li>
          <li>
            <span class="outside-almanac__legend-line is-moon" aria-hidden="true"></span>
            Moon
          </li>
          <li>
            <span class="outside-almanac__legend-line is-temperature" aria-hidden="true"></span>
            Temp
          </li>
        </ul>
      </div>

      <div class="outside-almanac__chart-scroll">
        <svg
          class="outside-almanac__chart"
          data-ribbon
          viewBox="0 0 1440 200"
          role="img"
          aria-label="Rolling Sun and Moon altitude and temperature chart for Breckenridge"
          focusable="false"
        ></svg>
      </div>

      <div class="outside-almanac__moon-visibility">
        <p>Moon above horizon</p>
        <strong data-field="moon-visibility-summary">Calculating tonight’s window…</strong>
        <small>Weather and daylight affect actual visibility.</small>
      </div>

      <dl class="outside-almanac__rail" aria-label="Current field notes and forecasts">
        <div>
          <dt>
            <span>01</span> Exposure
            <svg class="outside-almanac__gauge outside-almanac__gauge--uv" viewBox="0 0 48 26" aria-hidden="true">
              <path d="M 6 22 A 18 18 0 0 1 42 22" fill="none" stroke="currentColor" stroke-opacity="0.22" stroke-width="2.5" stroke-linecap="round" />
              <path d="M 11.3 9.3 L 12.8 10.8 M 24 4 L 24 6.2 M 36.7 9.3 L 35.2 10.8" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.2" stroke-linecap="round" />
              <g data-gauge="uv-needle" transform="translate(24, 22) rotate(-90)">
                <line x1="0" y1="0" x2="0" y2="-14" stroke="var(--outside-sun-line)" stroke-width="1.6" stroke-linecap="round" />
                <circle cx="0" cy="-18" r="2.8" fill="var(--outside-sun-line)" />
              </g>
              <circle cx="24" cy="22" r="2" fill="currentColor" fill-opacity="0.55" />
            </svg>
          </dt>
          <dd>
            <strong data-field="exposure-value">UV —</strong>
            <small data-field="exposure-detail">reading live conditions</small>
          </dd>
        </div>
        <div>
          <dt>
            <span>02</span> Air
            <svg class="outside-almanac__gauge outside-almanac__gauge--compass" viewBox="0 0 32 32" aria-hidden="true">
              <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-opacity="0.24" stroke-width="1.2" />
              <path d="M16 2.5v3M16 26.5v3M2.5 16h3M26.5 16h3" stroke="currentColor" stroke-opacity="0.4" stroke-width="1.2" stroke-linecap="round" />
              <g data-gauge="wind-needle" transform="translate(16, 16) rotate(0)">
                <path d="M0 -10.5 L3 5.5 L0 2.5 L-3 5.5 Z" fill="var(--color-signal)" />
              </g>
              <circle cx="16" cy="16" r="1.6" fill="var(--outside-plate-edge)" stroke="currentColor" stroke-width="1" />
            </svg>
          </dt>
          <dd>
            <strong data-field="air-value">— mph</strong>
            <small data-field="air-detail">wind and humidity</small>
          </dd>
        </div>
        <div>
          <dt>
            <span>03</span> Water
            <svg class="outside-almanac__gauge outside-almanac__gauge--spark" viewBox="0 0 60 22" data-gauge="rain-spark" aria-hidden="true">
              <line x1="1" y1="20" x2="59" y2="20" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
            </svg>
          </dt>
          <dd>
            <strong data-field="water-value">—% rain</strong>
            <small data-field="water-detail">precipitation outlook</small>
          </dd>
        </div>
        <div>
          <dt>
            <span>04</span> Sunset potential
            <svg class="outside-almanac__gauge outside-almanac__gauge--strata" viewBox="0 0 48 22" aria-hidden="true">
              <path data-gauge="cloud-high" d="M4 5c5-2 10 2 15 0s10-2 15 0 7 1 10-1" fill="none" stroke="var(--outside-sun-line)" stroke-width="2" stroke-linecap="round" opacity="0.35" />
              <path data-gauge="cloud-mid" d="M6 11.5h22m6 0h10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" opacity="0.3" />
              <rect data-gauge="cloud-low" x="4" y="16.5" width="40" height="3.2" rx="1.6" fill="currentColor" opacity="0.22" />
            </svg>
          </dt>
          <dd>
            <strong data-field="sunset-value">Potential pending</strong>
            <small data-field="sunset-detail">cloud layers near sunset</small>
          </dd>
        </div>
      </dl>

      <p class="outside-almanac__iss" data-field="iss-summary" aria-live="polite">
        Finding the next visible ISS pass…
      </p>
    </div>
  </div>
</section>

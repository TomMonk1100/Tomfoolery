---
import Layout from '../../layouts/Layout.astro';
import EntryTrail from '../../components/EntryTrail.astro';
import { getCollection, render } from 'astro:content';

const pieces = (await getCollection('art')).sort((a, b) =>
  (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)
);
const featured = pieces[0];
const rendered = featured ? await render(featured) : null;
const FeaturedContent = rendered?.Content;
const categoryLabel = {
  'coffee-art': 'Latte art',
  'hand-drawn': 'Hand-drawn',
  'ai-art': 'AI art',
};
---

<Layout
  title="Art — Tomfoolery"
  description="Drawings and visual experiments from Tom's art shelf."
  image="/images/social/art.png"
  imageAlt="Art on Tomfoolery — drawings and visual experiments."
>
  <article class="editorial-page editorial-art">
    <header class="editorial-page-lead">
      <div>
        <span class="editorial-kicker">Art shelf · {pieces.length} work{pieces.length === 1 ? '' : 's'}</span>
        <h1>A small exhibition.</h1>
      </div>
      <p>
        Drawings and experiments get a proper wall here. The room is small for
        now, so each piece gets space instead of being stretched into a grid.
      </p>
    </header>

    {featured && FeaturedContent ? (
      <section class="editorial-exhibit reveal" aria-labelledby="featured-work-title">
        {featured.data.image ? (
          <figure class="editorial-exhibit__image">
            <img src={featured.data.image} alt={featured.data.title} loading="eager" decoding="async" />
          </figure>
        ) : (
          <a href={`/art/${featured.id}`} class="editorial-exhibit__placard" aria-label={`Read ${featured.data.title}`}>
            <span>Work {String(1).padStart(2, '0')}</span>
            <strong>{featured.data.title}</strong>
            <small>Story and image notes →</small>
          </a>
        )}
        <div class="editorial-exhibit__label">
          <span class="editorial-kicker">Featured work</span>
          <h2 id="featured-work-title">{featured.data.title}</h2>
          <dl>
            <div><dt>Medium</dt><dd>{categoryLabel[featured.data.category]}</dd></div>
            {featured.data.date && <div><dt>Dated</dt><dd>{featured.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</dd></div>}
          </dl>
          <div class="editorial-prose"><FeaturedContent /></div>
          <a href={`/art/${featured.id}`} class="editorial-text-link">Open the full entry →</a>
        </div>
      </section>
    ) : (
      <p class="editorial-empty">The first work has not been hung yet.</p>
    )}

    <EntryTrail contextLinks={[
      { href: '/coffee', label: 'Coffee gallery', note: 'another kind of morning composition' },
      { href: '/pokemon', label: 'Pokémon binder', note: 'stories from another collection' },
    ]} />
  </article>
</Layout>

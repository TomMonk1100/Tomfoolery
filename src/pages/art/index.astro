---
import Layout from '../../layouts/Layout.astro';
import photos from '../../data/snoopyPhotos.json';
---

<Layout
  title="Art — Tomfoolery"
  description="Recent Daily Snoopy drawings from Tom's sketchbook."
  image="/images/social/art.png"
  imageAlt="Drawings from Tom's Daily Snoopy sketchbook."
>
  <article class="editorial-page editorial-art">
    <header class="editorial-page-lead editorial-art__lead">
      <div>
        <span class="editorial-kicker">Art · {photos.length} drawings</span>
        <h1>Daily Snoopy.</h1>
      </div>
      <p>
        I'm still working on my daily Snoopy. It's just not every day, but here
        are some of my recent ones.
      </p>
    </header>

    <div class="editorial-art__grid" data-gallery>
      {photos.map((photo, index) => (
        <figure class="editorial-gallery-item reveal">
          <button
            type="button"
            data-gallery-open={String(index)}
            aria-label={`Open drawing ${index + 1} of ${photos.length}: ${photo.alt}`}
          >
            <img
              src={photo.thumbnail}
              srcset={`${photo.thumbnail} ${photo.thumbWidth}w, ${photo.src} ${photo.width}w`}
              sizes="(min-width: 761px) 30vw, (min-width: 441px) 45vw, calc(100vw - 3rem)"
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading={index < 3 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            <span aria-hidden="true">View</span>
          </button>
        </figure>
      ))}
    </div>

    <dialog class="editorial-viewer" data-gallery-dialog aria-label="Snoopy drawing viewer">
      <div class="editorial-viewer__bar">
        <p data-gallery-count>Drawing 1 of {photos.length}</p>
        <button type="button" data-gallery-close aria-label="Close drawing viewer">Close</button>
      </div>
      <figure>
        <img data-gallery-image src={photos[0].src} alt={photos[0].alt} />
      </figure>
      <div class="editorial-viewer__nav">
        <button type="button" data-gallery-prev>← Previous</button>
        <button type="button" data-gallery-next>Next →</button>
      </div>
    </dialog>
  </article>

  <script define:vars={{ photos }}>
    function setupSnoopyGallery() {
      const dialog = document.querySelector('[data-gallery-dialog]');
      if (!(dialog instanceof HTMLDialogElement) || dialog.dataset.ready) return;
      dialog.dataset.ready = 'true';

      const image = dialog.querySelector('[data-gallery-image]');
      const count = dialog.querySelector('[data-gallery-count]');
      let current = 0;
      let returnFocus = null;

      const show = (index) => {
        current = (index + photos.length) % photos.length;
        const photo = photos[current];
        image.src = photo.src;
        image.alt = photo.alt;
        count.textContent = `Drawing ${current + 1} of ${photos.length}`;
      };

      document.querySelectorAll('[data-gallery-open]').forEach((button) => {
        button.addEventListener('click', () => {
          returnFocus = button;
          show(Number(button.getAttribute('data-gallery-open')));
          dialog.showModal();
          dialog.querySelector('[data-gallery-close]')?.focus();
        });
      });
      dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
      dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
      });
      dialog.addEventListener('close', () => returnFocus?.focus());
    }
    document.addEventListener('astro:page-load', setupSnoopyGallery);
    setupSnoopyGallery();
  </script>
</Layout>

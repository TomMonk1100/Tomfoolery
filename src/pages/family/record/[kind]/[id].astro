---
import Layout from '../../../../layouts/Layout.astro';
import SharedFamilyRecord from '../../../../components/SharedFamilyRecord.astro';
import { sharedRecords } from '../../../../data/shared-family-records';
import '../../../../styles/family.css';
import '../../../../styles/shared-family.css';
export function getStaticPaths() {
  return Object.values(sharedRecords).filter(r => r.kind !== 'person').map(record => ({ params: { kind: record.kind, id: record.id }, props: { record } }));
}
const { record } = Astro.props;
---
<Layout title={`${record.title} — Family history`} description={`Family-provided ${record.kind} details and source references.`} noindex><SharedFamilyRecord record={record} /></Layout>

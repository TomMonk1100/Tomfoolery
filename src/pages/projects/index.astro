---
import Layout from '../../layouts/Layout.astro';
import EntryTrail from '../../components/EntryTrail.astro';
import { getCollection } from 'astro:content';

/*
  PIP'S LABORATORY — the projects index.

  SCALABILITY CONTRACT (read before adding a project):
  This page is fully data-driven from the `projects` collection. To add a
  piece, drop in one new src/content/projects/<slug>.md (plus its standalone
  public/projects/<slug>.html and public/images/projects/<slug>.png) and it
  appears here with ZERO edits to this file:
    - The newest three pieces after the keystone automatically take the "Newest on the bench"
      shelf; the keystone bench shows the entry with `featured: true` in its
      frontmatter (falling back to the slug `grand-unified`, then the newest).
    - Every piece is shelved on a themed bench ("wing"). Its wing is, in
      order: the optional `wing:` frontmatter field (an enum in the schema —
      a typo fails the build loudly), the SLUG_WING map below, or the
      default `cabinet` bench ("The Cabinet — unclassified"). An unknown
      slug therefore always lands somewhere visible.
    - Specimen numbers are accession numbers by filing date: oldest piece
      is № 01. A piece filed with the newest date (the normal workflow)
      appends at the end and no existing number changes; a deliberately
      backdated entry takes its chronological place and renumbers the
      pieces younger than it.
    - Counts, stats, filter tallies and the live result count are computed
      from the whole collection at build time. Never hand-write a number.
  SCOPE OF THE ZERO-EDIT PROMISE: it holds for new projects within the
  existing four kinds and seven wings. A genuinely new kind or wing is a
  deliberate edit (schema enum + label/wing metadata here) — by design.
  Nothing validates that a new entry's `file:`/`image:` belong to its slug;
  check them when filing the entry.
  Wing ids: number | swarms | critical | earth | senses | workbench | cabinet.
*/

/* Deterministic order: date desc, slug asc as tie-break (many pieces share
   a build date; never rely on loader order). */
const entries = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id)
);

const kindLabel: Record<string, string> = {
  simulation: 'Simulation',
  game: 'Game',
  toy: 'Toy',
  generative: 'Generative',
};

interface WingMeta { id: string; label: string; blurb: string; hue: number }
const WINGS: WingMeta[] = [
  { id: 'number',    label: 'Number & Pattern',    blurb: 'Counts, cycles and records — arithmetic with its sleeves rolled up.', hue: 78 },
  { id: 'swarms',    label: 'Swarms & Simple Rules', blurb: 'One small rule each, repeated until behaviour shows up.', hue: 145 },
  { id: 'critical',  label: 'Critical Points',     blurb: 'Dials with a flip in them — and the measurements that pinned the flip down.', hue: 350 },
  { id: 'earth',     label: 'Earth & Sky',         blurb: 'Rainbows, tides, snow and rivers — the world outside, modelled honestly.', hue: 205 },
  { id: 'senses',    label: 'Sound, Sight & Mind', blurb: 'What ears and eyes actually receive, and the shortcuts the brain takes with it.', hue: 285 },
  { id: 'workbench', label: 'The Workbench',       blurb: 'Generative pieces and playable things — made to be touched, not just watched.', hue: 32 },
  { id: 'cabinet',   label: 'The Cabinet',         blurb: 'Filed, but not yet classified. Every laboratory has one drawer like this.', hue: 60 },
];
const wingById = new Map(WINGS.map((w) => [w.id, w]));

/* Explicit slug → wing map. A slug missing here (and without a `wing:`
   frontmatter field) falls back to the Cabinet — never to nowhere. */
const SLUG_WING: Record<string, string> = {
  'collatz': 'number', 'kaprekar': 'number', 'prime-gaps': 'number',
  'continued-fractions': 'number', 'feigenbaum': 'number', 'tilings': 'number',
  'monomer-dimer': 'number',
  'flock': 'swarms', 'fireflies': 'swarms', 'pulseflies': 'swarms',
  'hopf': 'swarms', 'formica': 'swarms', 'langtons-ant': 'swarms',
  'eca': 'swarms', 'dla': 'swarms', 'sandpile': 'swarms', 'sir': 'swarms',
  'perc': 'critical', 'ising-beta': 'critical', 'ising-fluct': 'critical',
  'instinct-field': 'critical', 'polya-walks': 'critical',
  'grand-unified': 'critical',
  'rainbow': 'earth', 'tides': 'earth', 'snowflakes': 'earth',
  'aurora': 'earth', 'meanders': 'earth',
  'shepard': 'senses', 'bouba-kiki': 'senses', 'metamers': 'senses',
  'dawn-chorus': 'senses', 'waggle': 'senses',
  'allspark': 'workbench', 'chain': 'workbench', 'night-garden': 'workbench',
  'silt': 'workbench', 'minstrel': 'workbench', 'minstrel-harmony': 'workbench',
  'minstrel-novelty': 'workbench', 'lights-out': 'workbench', 'maze': 'workbench',
  'pip-3d': 'workbench',
};

/* Optional wide hero crops for a keystone, keyed by slug. Presentation only:
   a featured piece without an entry here simply uses its preview image. */
const FEATURED_HERO: Record<string, string> = {
  'grand-unified': '/images/projects/grand-unified-hero.png',
};

type Entry = (typeof entries)[number];
const wingOf = (e: Entry): string => {
  const declared = (e.data as { wing?: string }).wing;
  if (declared && wingById.has(declared)) return declared;
  return SLUG_WING[e.id] ?? 'cabinet';
};

/* Accession numbers: oldest → № 01, newest → highest. Appending a piece
   never renumbers an existing specimen. Same tie-break as the main sort. */
const byAccession = [...entries].sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id)
);
const specimenNo = new Map(byAccession.map((e, i) => [e.id, String(i + 1).padStart(2, '0')]));

const featuredFlagged = entries.filter((e) => (e.data as { featured?: boolean }).featured);
if (featuredFlagged.length > 1) {
  console.warn(`[laboratory] ${featuredFlagged.length} entries claim featured: true; the newest wins, the rest are shelved normally.`);
}
const featured =
  featuredFlagged[0] ??
  entries.find((e) => e.id === 'grand-unified') ??
  entries[0];
const rest = entries.filter((e) => e.id !== featured?.id);
const bench = rest.slice(0, 3);
const benchIds = new Set(bench.map((e) => e.id));
const wall = rest.filter((e) => !benchIds.has(e.id));

const wallByWing = WINGS
  .map((wing) => ({ wing, pieces: wall.filter((e) => wingOf(e) === wing.id) }))
  .filter((g) => g.pieces.length > 0);

/* Filter tallies cover the WHOLE collection (keystone and bench included) —
   the controls filter every piece on the page, so the counts must too. */
const wingTallies = WINGS
  .map((wing) => ({ wing, n: entries.filter((e) => wingOf(e) === wing.id).length }))
  .filter((t) => t.n > 0);
const kindCounts = Object.entries(kindLabel)
  .map(([kind, label]) => ({ kind, label, n: entries.filter((e) => e.data.kind === kind).length }))
  .filter((k) => k.n > 0);
const benchCount = wallByWing.length + (featured ? 1 : 0); /* wall benches + the main bench */
const newest = entries[0];
const fmtMonth = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const searchText = (e: Entry) =>
  `${e.data.title} ${e.data.summary} ${kindLabel[e.data.kind]} ${wingById.get(wingOf(e))?.label ?? ''}`.toLowerCase();
const pieceAttrs = (e: Entry) => ({
  'data-piece': true,
  'data-wing': wingOf(e),
  'data-kind': e.data.kind,
  'data-date': e.data.date.valueOf(),
  'data-title': e.data.title.toLowerCase(),
  'data-search': searchText(e),
});

/* ── THE ROOM — point-and-click presentation ──────────────────────────────
   The /projects index is a room Pip lives in. Stations in the room are
   generated from the wing metadata above: every wing holding at least one
   piece gets a station button, a spot Pip walks to, a speech line, and a
   panel sheet listing that wing's pieces. Furniture in the scene is drawn
   per wing id and rendered only while that wing holds pieces.
   A new PROJECT still shelves itself with zero edits (it joins its wing's
   sheet, the search index and every count). A new WING is the same
   deliberate edit as before — schema enum + WINGS entry — plus one
   STATION_META entry and one furniture group in the scene below; a wing
   missing STATION_META falls back to a centre-room spot so it can never
   become unreachable. */
interface StationMeta {
  plate: string;                    /* nameplate label on the station */
  btn: string;                      /* inline style: left/top/width/height (%) over the scene */
  spot: [number, number];           /* where Pip stands, scene coords (1200 × 760) */
  line: (n: number) => string;      /* Pip's speech line, with the true count */
}
const STATION_FALLBACK: StationMeta = {
  plate: 'Uncharted bench', btn: 'left:44%;top:58%;width:12%;height:18%', spot: [612, 672],
  line: (n) => `${n} specimens on a bench I have not named yet. Give me time — the laboratory grows faster than its labels.`,
};
const STATION_META: Record<string, StationMeta> = {
  number: { plate: 'Number & Pattern', btn: 'left:2.5%;top:5%;width:24%;height:36%', spot: [180, 640],
    line: (n) => `${n} specimens of pure arithmetic — counts, cycles and records. The Kaprekar census on that board walked every number it could reach, so the patterns had nowhere left to hide.` },
  swarms: { plate: 'Swarms & Simple Rules', btn: 'left:27%;top:8%;width:17.5%;height:31%', spot: [398, 618],
    line: (n) => `${n} jars on this shelf, one small rule in each. Repeat a rule honestly enough and behaviour shows up — the flock in the big jar flips as one.` },
  critical: { plate: 'Critical Points', btn: 'left:32.5%;top:50%;width:12.5%;height:21%', spot: [472, 676],
    line: (n) => `${n} dials with a flip in them, all plumbed into this tank. My job is measuring exactly where each system changes its mind.` },
  earth: { plate: 'Earth & Sky', btn: 'left:69%;top:4.5%;width:27.5%;height:34%', spot: [968, 630],
    line: (n) => `${n} pieces of the world outside that window — rainbows, tides, snowflakes — modelled honestly, caveats and all. The telescope is for the aurora. It does what NOAA says it does.` },
  senses: { plate: 'Sound, Sight & Mind', btn: 'left:83.5%;top:45%;width:15%;height:27%', spot: [1100, 656],
    line: (n) => `${n} specimens for your ears and eyes. Mind the gramophone — the Shepard tone on it climbs forever and gets absolutely nowhere.` },
  workbench: { plate: 'The Workbench', btn: 'left:2.5%;top:54%;width:23%;height:20%', spot: [168, 678],
    line: (n) => `The Workbench — ${n} things made to be touched, not just watched. The minstrels compose, the maze re-checks itself live, and nothing here minds being poked.` },
  cabinet: { plate: 'The Cabinet', btn: 'left:26.3%;top:55%;width:6.5%;height:19%', spot: [344, 670],
    line: (n) => `The Cabinet — ${n} filed but not yet classified. Every laboratory has one drawer like this. This one is mine.` },
};
const KEYSTONE_META = {
  btn: 'left:45.2%;top:3%;width:22.5%;height:56%', spot: [680, 624] as [number, number],
  line: 'The Grand Unified Theory — one gold slider, six live systems, and every one of them flips as you drag through zero. This is the machine the whole laboratory points at. Mind your eyebrows.',
};
const BENCH_META = {
  btn: 'left:44.5%;top:59.5%;width:24%;height:17.5%', spot: [612, 672] as [number, number],
  line: 'Fresh specimens, still warm. The three newest pieces after the keystone — they have not even been shelved yet.',
};

const hasWing = (id: string) => entries.some((e) => wingOf(e) === id);
const roomStations = WINGS
  .map((wing) => ({ wing, pieces: entries.filter((e) => wingOf(e) === wing.id), meta: STATION_META[wing.id] ?? STATION_FALLBACK }))
  .filter((s) => s.pieces.length > 0);
const pctX = (v: number) => `${((v / 1200) * 100).toFixed(2)}%`;
const pctY = (v: number) => `${((v / 760) * 100).toFixed(2)}%`;
const chalkLatest = newest
  ? (newest.data.title.length > 24 ? `${newest.data.title.slice(0, 23)}…` : newest.data.title)
  : '';

/* The whole collection as a search index for the room's panel. Covers the
   keystone, the bench and every wing — the same whole-collection rule the
   list view's controls follow. `<` is escaped so a summary can never break
   out of the script island. */
const roomPieces = entries.map((e) => ({
  slug: e.id,
  no: specimenNo.get(e.id),
  title: e.data.title,
  kind: kindLabel[e.data.kind],
  wing: wingById.get(wingOf(e))?.label ?? '',
  date: fmtMonth(e.data.date),
  summary: e.data.summary,
  image: e.data.image ?? null,
  imageAlt: e.data.imageAlt ?? e.data.title,
  href: `/projects/${e.id}`,
  search: searchText(e),
}));
const roomJson = JSON.stringify(roomPieces).replace(/</g, '\\u003c');
---

<Layout
  title="Pip's Laboratory — Projects — Tomfoolery"
  description="Pip's laboratory is a room you can explore: click a bench, a tank, a window or the big machine, and Pip — the sprout who keeps the lab — will walk over and show you the experiments shelved there."
  image="/images/social/projects.png"
  imageAlt="Pip's laboratory — a point-and-click room full of interactive experiments."
>
  <header class="room-head">
    <p class="room-kicker">Pip's laboratory · {entries.length} experiments on file</p>
    <h1 class="room-title">Pip's Laboratory.</h1>
    <p class="room-lede">
      This is my room — I'm Pip, the sprout who keeps it. Every experiment I've
      built lives somewhere in here: on a bench, in a jar, in the tank, out the
      window. Click a station and I'll walk over and show you what's shelved
      there. Everything runs in your browser; mind the tank.
    </p>
    <div class="room-toolbar">
      <div class="room-searchbox" data-room-searchbox>
        <label class="room-sr" for="room-search-input">Search experiments</label>
        <input id="room-search-input" type="search" placeholder="Search the laboratory…" autocomplete="off" data-room-search />
      </div>
      <div class="room-toggle" role="group" aria-label="Choose how to browse the laboratory">
        <button type="button" data-view-btn="room" aria-pressed="true">The room</button>
        <button type="button" data-view-btn="list" aria-pressed="false">List view</button>
      </div>
    </div>
  </header>

  <section data-roomview aria-label="The laboratory room — explore by clicking a station">
    <div class="room-wrap">
      <div class="room" data-room data-active="" data-hover="">
        <svg class="room-scene" viewBox="0 0 1200 760" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1c150d" />
              <stop offset="100%" stop-color="#120d08" />
            </linearGradient>
            <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#2b1e11" />
              <stop offset="100%" stop-color="#1a120a" />
            </linearGradient>
            <radialGradient id="portalGrad" cx="50%" cy="46%" r="65%">
              <stop offset="0%" stop-color="#4a3572" />
              <stop offset="55%" stop-color="#241a3d" />
              <stop offset="100%" stop-color="#0d0a12" />
            </radialGradient>
            <linearGradient id="goldGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f2cd8a" />
              <stop offset="100%" stop-color="#c9963c" />
            </linearGradient>
            <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0b1026" />
              <stop offset="70%" stop-color="#16233f" />
              <stop offset="100%" stop-color="#1d2c47" />
            </linearGradient>
            <linearGradient id="boardGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#232a20" />
              <stop offset="100%" stop-color="#171c15" />
            </linearGradient>
            <linearGradient id="tankGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3fbfae" />
              <stop offset="52%" stop-color="#3f7fbf" />
              <stop offset="54%" stop-color="#c65b8f" />
              <stop offset="100%" stop-color="#8f3f6e" />
            </linearGradient>
            <radialGradient id="lampGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffdf9e" stop-opacity="0.5" />
              <stop offset="100%" stop-color="#ffdf9e" stop-opacity="0" />
            </radialGradient>
          </defs>

          {/* ── the room shell: wall, floor, rug, light ── */}
          <rect x="0" y="0" width="1200" height="545" fill="url(#wallGrad)" />
          <rect x="0" y="452" width="1200" height="10" fill="#3a2a16" />
          <rect x="0" y="528" width="1200" height="8" fill="#241708" />
          <rect x="0" y="540" width="1200" height="220" fill="url(#floorGrad)" />
          <g stroke="#120b05" stroke-width="3" opacity="0.55">
            <line x1="0" y1="578" x2="1200" y2="578" />
            <line x1="0" y1="620" x2="1200" y2="620" />
            <line x1="0" y1="668" x2="1200" y2="668" />
            <line x1="0" y1="716" x2="1200" y2="716" />
          </g>
          <g stroke="#120b05" stroke-width="2" opacity="0.35">
            <line x1="190" y1="540" x2="150" y2="760" />
            <line x1="480" y1="540" x2="470" y2="760" />
            <line x1="790" y1="540" x2="820" y2="760" />
            <line x1="1040" y1="540" x2="1100" y2="760" />
          </g>
          <ellipse cx="600" cy="676" rx="356" ry="46" fill="#54262a" />
          <ellipse cx="600" cy="676" rx="318" ry="37" fill="none" stroke="#c9963c" stroke-width="2" opacity="0.5" />
          <ellipse cx="680" cy="540" rx="230" ry="26" fill="#e7b568" opacity="0.06" />
          <polygon points="856,288 1140,288 1196,540 920,540" fill="#dfe9ff" opacity="0.045" />
          {/* pendant lamp over the chalkboard side */}
          <line x1="180" y1="0" x2="180" y2="44" stroke="#0d0a07" stroke-width="4" />
          <path d="M150 66 L180 44 L210 66 Z" fill="#2c2113" stroke="#c9963c" stroke-width="1.5" />
          <circle cx="180" cy="70" r="34" fill="url(#lampGlow)" class="lamp-halo" />

          {hasWing('number') && (
            <g class="furn furn-number">
              <rect x="38" y="48" width="284" height="254" rx="8" fill="#5a4026" />
              <rect x="48" y="58" width="264" height="234" rx="4" fill="url(#boardGrad)" />
              <g font-family="ui-monospace, Menlo, monospace" fill="#e9e6da">
                <text x="72" y="132" font-size="47" font-weight="700">6174</text>
                <text x="216" y="130" font-size="29" opacity="0.8">495</text>
                <text x="214" y="152" font-size="11" opacity="0.55">← 3 digits</text>
                <text x="72" y="182" font-size="25" opacity="0.92">3n+1</text>
                <text x="150" y="182" font-size="16" opacity="0.6">→ 1</text>
                <text x="72" y="212" font-size="12.5" opacity="0.72">every 4-digit number ends here.</text>
                <text x="72" y="230" font-size="12.5" opacity="0.72">the census checked them all.</text>
              </g>
              <text x="72" y="254" font-size="13.5" fill="#ffd98a" font-family="ui-monospace, Menlo, monospace">{entries.length} experiments on file</text>
              <text x="72" y="270" font-size="11.5" fill="#e9e6da" opacity="0.66" font-family="ui-monospace, Menlo, monospace">latest: {chalkLatest}</text>
              <rect x="252" y="283" width="34" height="6" rx="3" fill="#e9e6da" opacity="0.8" transform="rotate(-4 269 286)" />
            </g>
          )}

          {hasWing('swarms') && (
            <g class="furn furn-swarms">
              <rect x="330" y="82" width="8" height="180" fill="#3a2a16" />
              <rect x="522" y="82" width="8" height="180" fill="#3a2a16" />
              <rect x="326" y="150" width="208" height="10" rx="2" fill="#5a4026" />
              <rect x="326" y="248" width="208" height="10" rx="2" fill="#5a4026" />
              {/* firefly jar */}
              <g>
                <rect x="344" y="102" width="36" height="48" rx="8" fill="#cfe4ee" opacity="0.14" stroke="#cfe4ee" stroke-opacity="0.4" />
                <rect x="348" y="94" width="28" height="9" rx="3" fill="url(#goldGrad)" />
                <g fill="#ffe98a">
                  <circle cx="356" cy="122" r="2.6" class="twinkle" />
                  <circle cx="368" cy="134" r="2.1" class="twinkle tw2" />
                  <circle cx="362" cy="112" r="1.8" class="twinkle tw3" />
                  <circle cx="352" cy="140" r="1.7" class="twinkle tw2" />
                </g>
              </g>
              {/* flock jar */}
              <g>
                <rect x="394" y="98" width="40" height="52" rx="8" fill="#cfe4ee" opacity="0.14" stroke="#cfe4ee" stroke-opacity="0.4" />
                <rect x="399" y="90" width="30" height="9" rx="3" fill="url(#goldGrad)" />
                <g fill="#a5c94f">
                  <path d="M404 122 l9 -4 l-2 8 Z" />
                  <path d="M416 130 l9 -4 l-2 8 Z" />
                  <path d="M408 138 l9 -4 l-2 8 Z" />
                </g>
              </g>
              {/* ant farm */}
              <g>
                <rect x="448" y="104" width="34" height="46" rx="5" fill="#d9b98a" opacity="0.85" />
                <path d="M452 146 C460 128 466 140 470 122 C473 110 478 118 480 108" fill="none" stroke="#54401f" stroke-width="3.4" stroke-linecap="round" />
                <rect x="446" y="98" width="38" height="8" rx="3" fill="#3a2a16" />
              </g>
              {/* sandpile jar, bottom shelf */}
              <g>
                <rect x="352" y="198" width="38" height="50" rx="8" fill="#cfe4ee" opacity="0.14" stroke="#cfe4ee" stroke-opacity="0.4" />
                <rect x="357" y="190" width="28" height="9" rx="3" fill="url(#goldGrad)" />
                <path d="M358 244 L371 218 L384 244 Z" fill="#e0a458" />
                <path d="M364 244 L371 230 L378 244 Z" fill="#c9853e" />
              </g>
              {/* eca jar, bottom shelf */}
              <g>
                <rect x="404" y="198" width="38" height="50" rx="8" fill="#cfe4ee" opacity="0.14" stroke="#cfe4ee" stroke-opacity="0.4" />
                <rect x="409" y="190" width="28" height="9" rx="3" fill="url(#goldGrad)" />
                <g fill="#7fb2e8">
                  <path d="M419 208 l4 7 h-8 Z" />
                  <path d="M411 219 l4 7 h-8 Z" /><path d="M427 219 l4 7 h-8 Z" />
                  <path d="M403 230 l4 7 h-8 Z" /><path d="M419 230 l4 7 h-8 Z" /><path d="M435 230 l4 7 h-8 Z" />
                </g>
              </g>
              {/* pulse jar, bottom shelf */}
              <g>
                <rect x="456" y="198" width="38" height="50" rx="8" fill="#cfe4ee" opacity="0.14" stroke="#cfe4ee" stroke-opacity="0.4" />
                <rect x="461" y="190" width="28" height="9" rx="3" fill="url(#goldGrad)" />
                <circle cx="475" cy="224" r="9" fill="none" stroke="#ffd98a" stroke-width="2" class="pulse-ring" />
                <circle cx="475" cy="224" r="3" fill="#ffd98a" />
              </g>
              <text x="430" y="282" font-size="11" fill="#c2b294" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" opacity="0.8">do not shake</text>
            </g>
          )}


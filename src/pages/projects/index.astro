  <script>
    (() => {
      const init = () => {
        const roomView = document.querySelector('[data-roomview]');
        if (!roomView || roomView.dataset.roomInit) return;
        roomView.dataset.roomInit = '1';

        const room = roomView.querySelector('[data-room]');
        const pip = roomView.querySelector('[data-pip]');
        const flip = roomView.querySelector('[data-pip-flip]');
        const bubble = roomView.querySelector('[data-bubble]');
        const bubbleText = roomView.querySelector('[data-bubble-text]');
        const panel = roomView.querySelector('[data-panel]');
        const closeBtn = roomView.querySelector('[data-panel-close]');
        const kicker = roomView.querySelector('[data-panel-kicker]');
        const panelTitle = roomView.querySelector('[data-panel-title]');
        const blurb = roomView.querySelector('[data-panel-blurb]');
        const sheets = new Map(
          [...roomView.querySelectorAll('[data-sheet]')].map((s) => [s.dataset.sheet, s])
        );
        const searchInput = document.querySelector('[data-room-search]');
        const searchbox = document.querySelector('[data-room-searchbox]');
        const listView = document.querySelector('[data-listview]');
        const viewBtns = [...document.querySelectorAll('[data-view-btn]')];
        const RM = window.matchMedia('(prefers-reduced-motion: reduce)');
        const HOME = { x: 51, y: 88.42 };
        const WELCOME = "Welcome in! I'm Pip — this is my laboratory. Click a bench, the tank, the window, the big machine… and I'll walk over and show you what's there.";
        const HELLOS = [
          "That's me. Pip. I keep the lab, run the experiments, and sweep up the numbers.",
          'I grew a new leaf this week. Growth is kind of my whole thing.',
          'The chalkboard? 6174. Every four-digit number ends up there. Every single one — the census checked.',
          'Some days I just stand here and watch the tank. It flips when it wants to. So do I, apparently.',
        ];
        const HINTS = [
          'Psst — the big machine in the middle? Start there.',
          'The jars on the shelf are not as quiet as they look.',
          'The jars hum when the flock inside agrees. Listen closely at the shelf.',
          'Everything in the tank already flipped once, on the record. The panel has the measurements.',
        ];

        let pieces = [];
        try {
          pieces = JSON.parse(document.getElementById('room-pieces')?.textContent || '[]');
        } catch { pieces = []; }

        let lastBtn = null;
        let interacted = false;
        let idle = 0;
        let helloIdx = 0;
        let hintIdx = 0;
        let walkTimer = 0;
        let hintHush = 0;

        const hush = () => { bubble.hidden = true; bubble.dataset.idle = ''; };
        const say = (text, idleHint = false, hushMs = 0) => {
          bubbleText.textContent = text;
          bubble.hidden = false;
          bubble.dataset.idle = idleHint ? '1' : '';
          window.clearTimeout(hintHush);
          const ms = idleHint ? 9000 : hushMs;
          if (ms > 0) {
            hintHush = window.setTimeout(() => {
              if (bubbleText.textContent === text) hush();
            }, ms);
          }
        };
        roomView.querySelector('[data-bubble-close]')?.addEventListener('click', () => { hush(); idle = 0; });
        const wave = () => {
          pip.classList.remove('is-waving');
          void pip.offsetWidth;
          pip.classList.add('is-waving');
        };
        pip.addEventListener('animationend', (e) => {
          if (e.animationName === 'pip-wave-rot') pip.classList.remove('is-waving');
        });

        const moveTo = (x, y, done) => {
          const curX = parseFloat(pip.style.left) || HOME.x;
          const curY = parseFloat(pip.style.top) || HOME.y;
          const dx = x - curX;
          const depth = 0.88 + Math.min(1, Math.max(0, (y - 81) / 8.5)) * 0.2;
          flip.style.transform = `scaleX(${dx < -0.4 ? -1 : 1}) scale(${depth.toFixed(3)})`;
          const dist = Math.hypot(dx * 12, (y - curY) * 7.6);
          const dur = RM.matches ? 0 : Math.round(Math.min(1500, Math.max(320, dist * 1.6)));
          pip.style.transitionDuration = `${dur}ms`;
          pip.classList.add('is-walking');
          pip.style.left = `${x}%`;
          pip.style.top = `${y}%`;
          bubble.style.left = `${Math.min(80, Math.max(20, x))}%`;
          window.clearTimeout(walkTimer);
          walkTimer = window.setTimeout(() => {
            pip.classList.remove('is-walking');
            if (done) done();
          }, dur + 40);
        };

        const showSheet = (id) => {
          sheets.forEach((el, key) => { el.hidden = key !== id; });
        };

        const openStation = (btn) => {
          interacted = true; idle = 0; lastBtn = btn;
          const id = btn.dataset.station;
          room.dataset.active = id;
          showSheet(id);
          kicker.textContent = btn.dataset.kicker || '';
          panelTitle.textContent = btn.dataset.title || '';
          blurb.textContent = btn.dataset.blurb || '';
          panel.hidden = false;
          panel.style.setProperty('--panel-accent', btn.dataset.accent || '#e7b568');
          const sx = parseFloat(btn.dataset.spotX);
          const sy = parseFloat(btn.dataset.spotY);
          const arrive = () => {
            say(btn.dataset.line || '', false, 16000);
            wave();
            closeBtn.focus({ preventScroll: true });
          };
          moveTo(sx, sy, () => {
            /* Right-side stations sit where the sheet lands: Pip steps
               aside to present, so he is never hidden behind his own panel,
               and his bubble re-anchors clear of the sheet too. */
            if (sx > 60) {
              moveTo(58.5, sy, () => { bubble.style.left = '40%'; arrive(); });
            } else arrive();
          });
        };

        const closePanel = (goHome = true) => {
          if (panel.hidden) return;
          panel.hidden = true;
          room.dataset.active = '';
          hush();
          if (goHome) moveTo(HOME.x, HOME.y);
          if (lastBtn) lastBtn.focus({ preventScroll: true });
          else searchInput?.focus({ preventScroll: true });
        };
        closeBtn.addEventListener('click', () => closePanel(true));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !panel.hidden) closePanel(true);
        });

        roomView.querySelectorAll('[data-station]').forEach((btn) => {
          btn.addEventListener('click', () => openStation(btn));
          btn.addEventListener('mouseenter', () => { room.dataset.hover = btn.dataset.station; });
          btn.addEventListener('mouseleave', () => { room.dataset.hover = ''; });
          btn.addEventListener('focus', () => { room.dataset.hover = btn.dataset.station; });
          btn.addEventListener('blur', () => { room.dataset.hover = ''; });
        });

        pip.addEventListener('click', () => {
          interacted = true; idle = 0;
          wave();
          say(HELLOS[helloIdx++ % HELLOS.length], false, 9000);
        });

        /* ── Search: one index over the whole room ── */
        const resultsEl = roomView.querySelector('[data-search-results]');
        const statusEl = roomView.querySelector('[data-search-status]');
        const buildCard = (p) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'room-card';
          a.href = p.href;
          if (p.image) {
            const img = document.createElement('img');
            img.src = p.image; img.alt = ''; img.loading = 'lazy';
            a.append(img);
          } else {
            const s = document.createElement('span');
            s.className = 'room-card__nopic'; s.textContent = p.kind;
            a.append(s);
          }
          const body = document.createElement('span'); body.className = 'room-card__body';
          const meta = document.createElement('span'); meta.className = 'room-card__meta';
          meta.textContent = `№ ${p.no} · ${p.kind} · ${p.wing}`;
          const title = document.createElement('span'); title.className = 'room-card__title';
          title.textContent = p.title;
          const sum = document.createElement('span'); sum.className = 'room-card__summary';
          sum.textContent = p.summary;
          body.append(meta, title, sum);
          a.append(body);
          li.append(a);
          return li;
        };
        let searchTimer = 0;
        searchInput?.addEventListener('input', () => {
          window.clearTimeout(searchTimer);
          searchTimer = window.setTimeout(() => {
            const q = searchInput.value.trim().toLowerCase();
            interacted = true; idle = 0;
            if (q.length < 2) {
              statusEl.textContent = '';
              resultsEl.replaceChildren();
              if (!panel.hidden && sheets.get('search') && !sheets.get('search').hidden) closePanel(false);
              return;
            }
            const hits = pieces.filter((p) => p.search.includes(q));
            resultsEl.replaceChildren(...hits.map(buildCard));
            statusEl.textContent = hits.length
              ? `${hits.length} of ${pieces.length} experiments match “${q}”.`
              : `Nothing in the laboratory matches “${q}”. Try a shorter word — or ask a bench.`;
            lastBtn = null;
            room.dataset.active = '';
            panel.style.setProperty('--panel-accent', '#e7b568');
            showSheet('search');
            kicker.textContent = "Pip's index";
            panelTitle.textContent = 'Search the laboratory';
            blurb.textContent = 'Every piece in the room is in this index — the keystone, the fresh bench and all the benches.';
            panel.hidden = false;
            moveTo(HOME.x, HOME.y, () => {
              say(hits.length
                ? `Found ${hits.length}. They're listed in the panel — tap one to open it.`
                : `Nothing by that name in here. Try “flock”, “tide” or “tone”.`);
            });
          }, 160);
        });

        /* ── Room / list view toggle ── */
        const setView = (v, store = true) => {
          const list = v === 'list';
          roomView.hidden = list;
          if (listView) listView.hidden = !list;
          viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v)));
          if (searchbox) searchbox.style.visibility = list ? 'hidden' : '';
          if (list) { panel.hidden = true; hush(); }
          if (store) { try { localStorage.setItem('pip-lab-view', v); } catch { /* private mode */ } }
        };
        viewBtns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn)));
        try {
          if (localStorage.getItem('pip-lab-view') === 'list') setView('list', false);
        } catch { /* private mode */ }

        /* ── Idle life: a wave now and then, a hint if you linger ── */
        roomView.addEventListener('pointerdown', () => { interacted = true; idle = 0; }, true);
        roomView.addEventListener('keydown', () => { interacted = true; idle = 0; }, true);
        const idleTimer = window.setInterval(() => {
          idle += 1;
          if (idle === 16) wave();
          if (idle > 0 && idle % 30 === 0 && panel.hidden && bubble.hidden) {
            say(HINTS[hintIdx++ % HINTS.length], true);
          }
        }, 1000);
        document.addEventListener('astro:before-swap', () => window.clearInterval(idleTimer), { once: true });

        requestAnimationFrame(() => {
          const wrap = roomView.querySelector('.room-wrap');
          if (wrap && wrap.scrollWidth > wrap.clientWidth + 4) {
            wrap.scrollLeft = (wrap.scrollWidth - wrap.clientWidth) / 2;
          }
        });
        window.setTimeout(() => wave(), 450);
        window.setTimeout(() => { if (!interacted) say(WELCOME, true); }, 950);
      };
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init();
      else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
  <script>
    (() => {
      const init = () => {
        const root = document.querySelector('[data-lab]');
        if (!root || root.dataset.labInit) return;
        root.dataset.labInit = '1';

        const pieces = [...root.querySelectorAll('[data-piece]')];
        const sections = [...root.querySelectorAll('[data-bench]')];
        const mainBench = root.querySelector('[data-main-bench]');
        const running = root.querySelector('[data-running]');
        const keystone = root.querySelector('.lab-keystone');
        const minis = [...root.querySelectorAll('.lab-mini')];
        const countEl = root.querySelector('[data-lab-count]');
        const emptyEl = root.querySelector('[data-lab-empty]');
        const searchEl = root.querySelector('[data-lab-search]');
        const sortEl = root.querySelector('[data-lab-sort]');
        const total = pieces.length;
        const state = { wing: 'all', kind: 'all', q: '', sort: 'new' };
        let firstApply = true;
        let countTimer = 0;

        const matches = (el) =>
          (state.wing === 'all' || el.dataset.wing === state.wing) &&
          (state.kind === 'all' || el.dataset.kind === state.kind) &&
          (state.q === '' || el.dataset.search.includes(state.q));

        const apply = () => {
          let shown = 0;
          for (const el of pieces) {
            const ok = matches(el);
            el.hidden = !ok;
            if (ok) shown += 1;
          }
          for (const section of sections) {
            const inSection = [...section.querySelectorAll('.lab-card')];
            const visible = inSection.filter((c) => !c.hidden).length;
            section.hidden = visible === 0;
            const label = section.querySelector('[data-bench-count]');
            if (label) {
              label.textContent =
                visible === inSection.length
                  ? `${inSection.length} on this bench`
                  : `${visible} of ${inSection.length} on this bench`;
            }
          }
          if (running) running.hidden = minis.every((m) => m.hidden);
          if (mainBench) mainBench.hidden = (keystone?.hidden ?? true) && minis.every((m) => m.hidden);
          if (emptyEl) emptyEl.hidden = shown !== 0;
          if (countEl && !firstApply) {
            window.clearTimeout(countTimer);
            countTimer = window.setTimeout(() => {
              countEl.textContent =
                shown === total
                  ? `${total} experiments in the laboratory — the controls search and filter all of them.`
                  : `Showing ${shown} of ${total} experiments.`;
            }, 300);
          }
          firstApply = false;
        };

        const sortCards = () => {
          for (const section of sections) {
            const grid = section.querySelector('.lab-grid');
            if (!grid) continue;
            const sorted = [...grid.querySelectorAll('.lab-card')].sort((a, b) => {
              if (state.sort === 'az') return a.dataset.title.localeCompare(b.dataset.title);
              const d = Number(a.dataset.date) - Number(b.dataset.date);
              return state.sort === 'old' ? d : -d;
            });
            sorted.forEach((c) => grid.appendChild(c));
          }
        };

        /* Radio-group behaviour: one selection per rail, roving tabindex,
           arrow keys move the selection (ARIA radio pattern). */
        const setupRadioGroup = (attr, key) => {
          const group = root.querySelector(`[aria-label="Filter by ${key === 'wing' ? 'bench' : 'kind'}"]`);
          const buttons = [...root.querySelectorAll(`[${attr}]`)];
          if (!group || buttons.length === 0) return;
          const select = (btn, focus = false) => {
            state[key] = btn.getAttribute(attr);
            buttons.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-checked', String(active));
              b.tabIndex = active ? 0 : -1;
            });
            if (focus) btn.focus();
            apply();
          };
          buttons.forEach((btn, i) => {
            btn.addEventListener('click', () => select(btn));
            btn.addEventListener('keydown', (e) => {
              let next = null;
              if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = buttons[(i + 1) % buttons.length];
              else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = buttons[(i - 1 + buttons.length) % buttons.length];
              else if (e.key === 'Home') next = buttons[0];
              else if (e.key === 'End') next = buttons[buttons.length - 1];
              if (next) { e.preventDefault(); select(next, true); }
            });
          });
          return (btn) => select(btn);
        };
        const selectWing = setupRadioGroup('data-wing-filter', 'wing');
        const selectKind = setupRadioGroup('data-kind-filter', 'kind');

        searchEl?.addEventListener('input', () => {
          state.q = searchEl.value.trim().toLowerCase();
          apply();
        });
        sortEl?.addEventListener('change', () => {
          state.sort = sortEl.value;
          sortCards();
          apply();
        });
        root.querySelector('[data-lab-reset]')?.addEventListener('click', () => {
          state.sort = 'new';
          if (sortEl) sortEl.value = 'new';
          sortCards();
          if (searchEl) searchEl.value = '';
          state.q = '';
          selectWing?.(root.querySelector('[data-wing-filter="all"]'));
          selectKind?.(root.querySelector('[data-kind-filter="all"]'));
          apply();
          searchEl?.focus();
        });
        apply();

        /* Ambient bench light: slow dust motes on a viewport-height canvas.
           One derived pause state (hidden tab OR off-screen OR reduced
           motion); the loop fully stops when paused. */
        const canvas = root.querySelector('[data-lab-ambient]');
        if (canvas) {
          const ctx = canvas.getContext('2d');
          const motionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
          let w = 0, h = 0, raf = 0, intersecting = false, pointer = null;
          const motes = Array.from({ length: 55 }, () => ({
            x: Math.random(), y: Math.random(),
            r: 0.6 + Math.random() * 1.7,
            s: 0.008 + Math.random() * 0.03,
            drift: (Math.random() - 0.5) * 0.01,
            a: 0.12 + Math.random() * 0.3,
          }));
          const resize = () => {
            w = root.clientWidth; h = window.innerHeight;
            canvas.width = Math.max(1, w);
            canvas.height = Math.max(1, h);
          };
          const draw = () => {
            ctx.clearRect(0, 0, w, h);
            const rect = canvas.getBoundingClientRect();
            for (const m of motes) {
              m.y -= m.s / 100; m.x += m.drift / 100;
              if (m.y < -0.02) { m.y = 1.02; m.x = Math.random(); }
              if (m.x < -0.02) m.x = 1.02; if (m.x > 1.02) m.x = -0.02;
              const px = m.x * w, py = m.y * h;
              let near = 0;
              if (pointer) {
                const dx = px - (pointer.x - rect.left), dy = py - (pointer.y - rect.top);
                near = Math.max(0, 1 - Math.hypot(dx, dy) / 190);
              }
              ctx.beginPath();
              ctx.arc(px, py, m.r + near * 1.6, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(231, 197, 130, ${(m.a + near * 0.35).toFixed(3)})`;
              ctx.fill();
            }
          };
          const loop = () => { draw(); raf = requestAnimationFrame(loop); };
          const sync = () => {
            const shouldRun = intersecting && !document.hidden && !motionMq.matches;
            if (shouldRun && !raf) loop();
            if (!shouldRun && raf) { cancelAnimationFrame(raf); raf = 0; }
            if (motionMq.matches) ctx.clearRect(0, 0, w, h);
          };
          resize();
          let resizeTimer = 0;
          window.addEventListener('resize', () => {
            window.clearTimeout(resizeTimer);
            resizeTimer = window.setTimeout(resize, 200);
          }, { passive: true });
          root.addEventListener('pointermove', (e) => { pointer = { x: e.clientX, y: e.clientY }; }, { passive: true });
          root.addEventListener('pointerleave', () => { pointer = null; });
          new IntersectionObserver(([entry]) => { intersecting = entry.isIntersecting; sync(); }, { threshold: 0 }).observe(root);
          document.addEventListener('visibilitychange', sync);
          motionMq.addEventListener?.('change', sync);
          document.addEventListener('astro:before-swap', () => { if (raf) cancelAnimationFrame(raf); }, { once: true });
        }
      };
      document.addEventListener('astro:page-load', init);
      if (document.readyState !== 'loading') init();
      else document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
</Layout>

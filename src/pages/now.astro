---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const lastUpdated = 'Sep 24, 2026';

const posts = (await getCollection('now')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<Layout
  title="Now — Tomfoolery"
  description="Right now: getting my steps in, reading, and keeping my head up through a hard stretch."
  image="/images/social/now.png"
  imageAlt="Now on Tomfoolery — current field notes over a dusk photograph."
>
  <article class="editorial-page editorial-now">
    <header class="editorial-page-lead editorial-now__lead">
      <div>
        <span class="editorial-kicker">Current field notes</span>
        <h1>Right now.</h1>
        <p class="editorial-now__updated">Last updated {lastUpdated}</p>
      </div>

      <p class="editorial-now__statement">
        Right now I'm working on losing weight, getting my steps in, and
        reading. I'm trying to keep my head up, too. I've been pretty
        depressed, but I'm making it.
      </p>

      <figure>
        <div class="overflow-hidden border border-line bg-surface p-1">
          <img
            src="/images/now-bats.webp"
            srcset="/images/now-bats-640.webp 640w, /images/now-bats.webp 1400w"
            sizes="(min-width: 1024px) 28vw, calc(100vw - 3rem)"
            width="1400"
            height="1051"
            alt="Tom looking up at a sky filled with bats at dusk."
            class="block h-auto w-full"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption class="mt-2 text-xs text-muted font-mono">
          A good reminder to look up once in a while.
        </figcaption>
      </figure>
    </header>

  {posts.length > 0 && (
    <section class="editorial-now__log">
      <header class="editorial-section-head">
        <div>
          <span class="editorial-kicker">Journal entries</span>
          <h2>The log.</h2>
        </div>
        <p>Earlier notes, in reverse chronological order.</p>
      </header>

      <div class="editorial-now__entries">
        {posts.map((post, i) => (
          <a href={`/now/${post.id}`} class="tile reveal flex gap-4 items-start" style={`transition-delay: ${Math.min(i * 60, 300)}ms`}>
            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="w-20 h-20 object-cover rounded-sm border border-line shrink-0" loading="lazy" />
            )}
            <div>
              <p class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted">
                <span>{fmt(post.data.date)}</span>
                {post.data.tag && <span class="badge">{post.data.tag}</span>}
                {post.data.location && <span>{post.data.location}</span>}
              </p>
              <h3 class="font-display font-semibold mt-1">{post.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <p class="editorial-now__almanac">
    Looking for the weather, sunset, moon phase, or the ISS? The live view is on
    the <a href="/" class="gradient-text font-medium">home page</a>.
  </p>
  </article>
</Layout>

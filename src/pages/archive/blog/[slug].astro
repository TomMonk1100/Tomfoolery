---
// Individual past-blog post — /archive/blog/:slug
import Layout from '../../../layouts/Layout.astro';
import EntryTrail from '../../../components/EntryTrail.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = (await getCollection('pastBlog')).sort((a, b) => {
    const timeDifference = b.data.date.valueOf() - a.data.date.valueOf();
    if (timeDifference !== 0) return timeDifference;
    if (a.id === b.id) return 0;
    return a.id < b.id ? 1 : -1;
  });

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newerEntry: entries[index - 1] ?? null,
      olderEntry: entries[index + 1] ?? null,
    },
  }));
}

const { entry, newerEntry, olderEntry } = Astro.props;
const { Content } = await render(entry);

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<Layout
  title={`${entry.data.title} — Tom of the Past`}
  description={entry.data.title}
  image="/images/social/archive.png"
  imageAlt="Tom of the Past, Tomfoolery's editorial archive of old blog posts and a decade of tweets."
  contentType="article"
  publishedTime={entry.data.date}
>
  <article class="editorial-page editorial-detail editorial-detail--archive">
  <a href="/archive" class="editorial-detail__back">← the vault</a>
  <header class="editorial-detail__head">
  <h1>{entry.data.title}</h1>
  <p class="editorial-detail__meta">{fmt(entry.data.date)} · from the old blog, lightly tidied</p>
  </header>

  <div class="editorial-detail__prose past-prose">
    <Content />
  </div>

  <EntryTrail
    ariaLabel="More from the old blog"
    newer={newerEntry ? {
      href: `/archive/blog/${newerEntry.id}`,
      eyebrow: 'Newer from the old blog',
      title: newerEntry.data.title,
    } : null}
    older={olderEntry ? {
      href: `/archive/blog/${olderEntry.id}`,
      eyebrow: 'Older from the old blog',
      title: olderEntry.data.title,
    } : null}
    contextLinks={[
      {
        href: '/archive/tweets',
        label: 'On this day in tweets',
        note: 'another path through the archive',
      },
      {
        href: '/now',
        label: 'Right now',
        note: 'the current chapter',
      },
    ]}
  />
  </article>
</Layout>

<style>
  .past-prose {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.05rem;
  }
</style>

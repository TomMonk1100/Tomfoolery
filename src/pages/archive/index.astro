---
// Archive hub — "Tom of the Past". Blog posts (2015–2016) + tweets (2008–2018)
// with a unified client-side search across both.
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('pastBlog')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const featuredPost = posts[posts.length - 1];
const years = [...new Set(posts.map((post) => post.data.date.getUTCFullYear()))].sort((a, b) => b - a);

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}
---

<Layout
  title="Archive — Tomfoolery"
  description="Tom of the Past: old blog posts and tweets, 2008–2018."
  image="/images/social/archive.png"
  imageAlt="Tom of the Past — old blog posts and tweets from 2008 through 2018."
>
  <article class="editorial-page editorial-archive">
    <header class="editorial-page-lead editorial-archive__lead">
      <div>
        <span class="editorial-kicker">From the vault</span>
        <h1>Tom of the Past.</h1>
      </div>
      <p>An archive of who I used to be online: {posts.length} blog posts from 2015–2016 and 13,686 tweets from 2008–2018.</p>
    </header>

    {featuredPost && (
      <section class="editorial-archive__feature" aria-labelledby="archive-featured-title">
        <span class="editorial-kicker">Featured essay · {featuredPost.data.date.getUTCFullYear()}</span>
        <h2 id="archive-featured-title">{featuredPost.data.title}</h2>
        <p>One old blog post to start with, preserved alongside the rest of the archive.</p>
        <a href={`/archive/blog/${featuredPost.id}`} class="editorial-text-link">Read the essay →</a>
      </section>
    )}

    <!-- Unified search -->
    <div class="editorial-archive__search retro-box">
      <label for="archive-search" class="font-mono text-xs text-muted uppercase tracking-wider">Search the vault</label>
      <input
        id="archive-search"
        type="search"
        placeholder="search tweets + blog posts…"
        autocomplete="off"
        class="mt-2 w-full bg-surface border border-line px-3 py-2 font-mono text-sm focus:outline-none focus:border-accent"
      />
      <div id="search-status" class="mt-2 font-mono text-xs text-muted"></div>
      <ul id="search-results" class="mt-2 space-y-3"></ul>
    </div>

    <div class="editorial-archive__columns">
      <!-- Tweets -->
      <section class="editorial-archive__tweets">
        <h2>Tweets <span>2008–2018</span></h2>
        <p class="mt-1 text-sm text-muted">13,686 original tweets (replies, retweets, and dead Instagram links left in the past).</p>
        <a href="/archive/tweets" class="tile block mt-4 p-5 retro-box">
          <span class="font-mono text-sm text-accent-ink">→ on this day in tweets</span>
        </a>
      </section>

      <!-- Blog -->
      <section class="editorial-archive__blog">
        <div class="editorial-archive__blog-head">
          <h2>Blog posts <span>2015–2016</span></h2>
          <label for="archive-year">Year <select id="archive-year"><option value="all">All years</option>{years.map((year) => <option value={String(year)}>{year}</option>)}</select></label>
        </div>
        <p class="editorial-empty" data-archive-empty hidden>No blog posts from that year.</p>
        <ul class="editorial-archive__post-list">
          {posts.map((p) => (
            <li data-archive-year={String(p.data.date.getUTCFullYear())}>
              <a href={`/archive/blog/${p.id}`}>{p.data.title}</a>
              <span>{fmt(p.data.date)}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>

  <script>
    let corpus: { tweets: any[]; blog: any[] } | null = null;
    let loading: Promise<void> | null = null;

    async function loadCorpus() {
      if (corpus) return;
      if (!loading) {
        loading = (async () => {
          const months = Array.from({ length: 12 }, (_, i) => String(i + 1).padStart(2, '0'));
          const [blog, ...tweetSets] = await Promise.all([
            fetch('/archive/blog-index.json').then((r) => r.json()),
            ...months.map((m) => fetch(`/archive/tweets-m${m}.json`).then((r) => (r.ok ? r.json() : []))),
          ]);
          corpus = { tweets: tweetSets.flat(), blog };
        })();
      }
      await loading;
    }

    function esc(s: string) {
      return s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
    }

    function snippet(text: string, q: string, len = 160) {
      const i = text.toLowerCase().indexOf(q);
      const start = Math.max(0, i - 40);
      const raw = (start > 0 ? '…' : '') + text.slice(start, start + len) + (start + len < text.length ? '…' : '');
      return esc(raw).replace(new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), (m) => `<mark>${m}</mark>`);
    }

    function setupSearch() {
      const input = document.getElementById('archive-search') as HTMLInputElement | null;
      const status = document.getElementById('search-status');
      const list = document.getElementById('search-results');
      if (!input || !status || !list || input.dataset.ready) return;
      input.dataset.ready = 'true';

      let timer: number;
      input.addEventListener('input', () => {
        clearTimeout(timer);
        timer = window.setTimeout(async () => {
          const q = input.value.trim().toLowerCase();
          list.innerHTML = '';
          if (q.length < 2) { status.textContent = ''; return; }
          status.textContent = 'digging through the vault…';
          await loadCorpus();
          if (!corpus) { status.textContent = 'could not load archive data.'; return; }

          const blogHits = corpus.blog.filter(
            (b) => b.title.toLowerCase().includes(q) || b.text.toLowerCase().includes(q)
          );
          const tweetHits = corpus.tweets.filter((t) => t.text.toLowerCase().includes(q));
          const shown: string[] = [];

          for (const b of blogHits.slice(0, 10)) {
            shown.push(
              `<li class="border-b border-dotted border-line pb-2">
                <span class="badge-signal font-mono text-xs">blog</span>
                <a href="/archive/blog/${b.slug}" class="ml-2 font-semibold hover:text-accent-ink">${esc(b.title)}</a>
                <span class="ml-2 font-mono text-xs text-muted">${b.date}</span>
                <p class="mt-1 text-sm text-muted">${snippet(b.text, q)}</p>
              </li>`
            );
          }
          for (const t of tweetHits.slice(0, 40)) {
            shown.push(
              `<li class="border-b border-dotted border-line pb-2">
                <span class="badge font-mono text-xs">tweet</span>
                <a href="/archive/tweets?date=${t.ts.slice(5, 10)}#t${t.id}" class="ml-2 font-mono text-xs text-muted hover:text-accent-ink">${t.ts}</a>
                <p class="mt-1 text-sm">${snippet(t.text, q)}</p>
              </li>`
            );
          }
          status.textContent = `${blogHits.length} blog post${blogHits.length === 1 ? '' : 's'}, ${tweetHits.length} tweet${tweetHits.length === 1 ? '' : 's'}${blogHits.length > 10 || tweetHits.length > 40 ? ' (showing first matches)' : ''}`;
          list.innerHTML = shown.join('');
        }, 250);
      });
    }

    document.addEventListener('astro:page-load', setupSearch);

    function setupArchiveYear() {
      const select = document.getElementById('archive-year') as HTMLSelectElement | null;
      const empty = document.querySelector('[data-archive-empty]');
      const posts = [...document.querySelectorAll('[data-archive-year]')];
      if (!select || select.dataset.ready) return;
      select.dataset.ready = 'true';
      select.addEventListener('change', () => {
        let visible = 0;
        posts.forEach((post) => {
          const show = select.value === 'all' || post.getAttribute('data-archive-year') === select.value;
          (post as HTMLElement).hidden = !show;
          if (show) visible += 1;
        });
        if (empty instanceof HTMLElement) empty.hidden = visible > 0;
      });
    }
    document.addEventListener('astro:page-load', setupArchiveYear);
    setupArchiveYear();
  </script>

  <style>
    .retro-box {
      border: 1px solid var(--color-line);
      box-shadow: 4px 4px 0 var(--color-surface-2);
      background: var(--color-surface);
    }
    mark {
      background: var(--color-accent-mid);
      color: var(--color-canvas);
      padding: 0 2px;
    }
  </style>
</Layout>

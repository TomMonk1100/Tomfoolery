---
import Layout from '../layouts/Layout.astro';
import Outside from '../components/Outside.astro';
import GameFeature from '../components/GameFeature.astro';
import { getCollection } from 'astro:content';

type DatedEntry = { id: string; data: { title: string; date?: Date; dateAcquired?: Date } };

function newest<T extends DatedEntry>(entries: T[], key: 'date' | 'dateAcquired') {
  return [...entries].sort((a, b) =>
    (b.data[key]?.valueOf() ?? 0) - (a.data[key]?.valueOf() ?? 0)
  )[0];
}

function monthYear(date?: Date) {
  return date?.toLocaleDateString('en-US', {
    month: 'short', year: 'numeric', timeZone: 'UTC',
  }) ?? 'Ongoing';
}

const [nowEntries, artEntries, pokemonEntries, archiveEntries] = await Promise.all([
  getCollection('now'), getCollection('art'), getCollection('pokemon'), getCollection('pastBlog'),
]);

const currentNotes = [
  { section: 'Now', hrefBase: '/now', entry: newest(nowEntries, 'date'), key: 'date' as const },
  { section: 'Art', hrefBase: '/art', entry: newest(artEntries, 'date'), key: 'date' as const },
  { section: 'Pokémon', hrefBase: '/pokemon', entry: newest(pokemonEntries, 'dateAcquired'), key: 'dateAcquired' as const },
];

const rediscovered = archiveEntries.find((entry) => entry.id === 'created-cabin')
  ?? [...archiveEntries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const destinations = [
  { n: '01', href: '/now', title: 'Now', note: 'What has my attention lately' },
  { n: '02', href: '/coffee', title: 'Coffee', note: 'Lattes, foam doodles, and ritual' },
  { n: '03', href: '/pokemon', title: 'Pokémon', note: 'Cards and the stories attached to them' },
  { n: '04', href: '/art', title: 'Art', note: 'Drawings and visual experiments' },
  { n: '05', href: '/archive', title: 'Archive', note: 'Old posts and ten years of tweets' },
  { n: '06', href: '/about', title: 'About', note: 'Work, animals, hobbies, and this place' },
];
---

<Layout
  image="/og.png"
  imageAlt="Tomfoolery over a warm West Texas landscape, with coffee, collections, old stories, and the sky traced beneath a sun-and-moon arc."
  preconnectWeather
>
  <div class="editorial-home">
    <section class="editorial-hero" aria-labelledby="home-heading">
      <div class="editorial-hero__copy">
        <span class="editorial-kicker">A personal journal from West Texas</span>
        <h1 id="home-heading">Things I make, collect, notice, and keep.</h1>
        <p>
          I’m Tom. This is where coffee rituals, Pokémon cards, old stories,
          new experiments, and the wide Texas sky end up together.
        </p>
        <nav class="editorial-hero__actions" aria-label="Start exploring">
          <a href="/now" class="editorial-button">See what’s current <span aria-hidden="true">→</span></a>
          <a href="/about" class="editorial-text-link">A little about me</a>
        </nav>
      </div>

      <figure class="editorial-hero__portrait">
        <div class="editorial-photo-mat">
          <img
            src="/images/about-tom.webp"
            srcset="/images/about-tom-480.webp 480w, /images/about-tom.webp 768w"
            sizes="(min-width: 1024px) 34vw, calc(100vw - 3rem)"
            width="768"
            height="1024"
            alt="Tom standing outdoors in warm evening light, wearing a suit and tie."
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <figcaption>Tom Muncie · Breckenridge, Texas</figcaption>
      </figure>
    </section>

    <section class="editorial-feature-row" aria-label="Featured work">
      <a href="/coffee" class="editorial-photo-feature reveal">
        <img
          src="/images/coffee/latte-breakfast.webp"
          srcset="/images/coffee/latte-breakfast-480.webp 480w, /images/coffee/latte-breakfast.webp 1024w"
          sizes="(min-width: 1024px) 38vw, calc(100vw - 3rem)"
          width="1024"
          height="768"
          alt="A latte with a smiling face beside breakfast and collectibles."
          loading="lazy"
          decoding="async"
        />
        <span class="editorial-photo-feature__shade"></span>
        <span class="editorial-photo-feature__copy">
          <small>Coffee journal</small>
          <strong>Before the first sip</strong>
          <span>Open the gallery →</span>
        </span>
      </a>
      <GameFeature />
    </section>

    <header class="editorial-section-head editorial-section-head--outside">
      <div>
        <span class="editorial-kicker">The living almanac</span>
        <h2>What the sky is doing.</h2>
      </div>
      <p>Local light, weather, Moon, and the next useful thing to look up for.</p>
    </header>
  </div>

  <Outside />

  <div class="editorial-home editorial-home--after-outside">
    <section class="editorial-notes" aria-labelledby="current-notes-heading">
      <header class="editorial-section-head">
        <div>
          <span class="editorial-kicker">Recently tended</span>
          <h2 id="current-notes-heading">The current shelf.</h2>
        </div>
        <p>Recent notes, kept separate from the older work below.</p>
      </header>

      <div class="editorial-notes__grid">
        {currentNotes.map((item, index) => item.entry && (
          <a href={`${item.hrefBase}/${item.entry.id}`} class="editorial-note reveal">
            <span class="editorial-note__meta">
              <span>{String(index + 1).padStart(2, '0')} · {item.section}</span>
              <time datetime={item.entry.data[item.key]?.toISOString()}>{monthYear(item.entry.data[item.key])}</time>
            </span>
            <strong>{item.entry.data.title}</strong>
            <span class="editorial-note__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    {rediscovered && (
      <section class="editorial-rediscovery reveal" aria-labelledby="rediscovery-heading">
        <div>
          <span class="editorial-kicker">Rediscovered in the archive · {rediscovered.data.date.getUTCFullYear()}</span>
          <h2 id="rediscovery-heading">{rediscovered.data.title}</h2>
        </div>
        <p>An older piece from the blog, brought back into view.</p>
        <a href={`/archive/blog/${rediscovered.id}`} class="editorial-text-link">Read from the archive →</a>
      </section>
    )}

    <section class="editorial-index" aria-labelledby="site-index-heading">
      <header class="editorial-section-head">
        <div>
          <span class="editorial-kicker">The rest of the cabinet</span>
          <h2 id="site-index-heading">Keep wandering.</h2>
        </div>
      </header>
      <nav aria-label="Explore Tomfoolery">
        {destinations.map((item) => (
          <a href={item.href}>
            <span>{item.n}</span>
            <strong>{item.title}</strong>
            <small>{item.note}</small>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </nav>
    </section>
  </div>
</Layout>

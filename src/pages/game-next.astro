---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Moon Lander — Tomfoolery" description="A warm illustrated endless Moon Lander from Tomfoolery." image="/images/social/game.png" imageAlt="Moon Lander on Tomfoolery">
  <main class="next-page">
    <div class="next-page-heading"><span class="badge">development flight deck</span><h1>Moon Lander <span>prototype</span></h1><p>Prototype route for the recovered presentation work. The stable flight model remains at <a href="/game">/game</a> while this profile earns its way back.</p></div>
    <section id="lander-next-root" class="next-console" aria-label="Moon Lander 1.0">
      <div data-next-viewport class="next-viewport">
        <canvas data-next-canvas aria-label="Moon Lander flight view"></canvas>
        <div class="next-hud" aria-label="Flight instruments">
          <div class="next-instrument"><span>DESCENT</span><b data-next-hud="level">1</b><small>SECTOR</small></div>
          <div class="next-vitals"><span>FUEL <b data-next-hud="fuel">100</b></span><span>ALT <b data-next-hud="altitude">—</b></span><span>DOWN <b data-next-hud="descent">0 u/s</b></span><span>DRIFT <b data-next-hud="drift">0 u/s</b></span><span>TRIM <b data-next-hud="attitude">0°</b></span></div>
          <div class="next-instrument next-status"><span>STATUS</span><b data-next-hud="landing">APPROACH</b><small>SCORE <em data-next-hud="score">00000</em></small></div>
        </div>
        <div class="next-touch" aria-label="Touch controls"><button data-next-input="left" aria-label="Rotate left">↶</button><button data-next-input="right" aria-label="Rotate right">↷</button><button data-next-input="thrust" aria-label="Thrust">▲</button></div>
        <div data-next-overlay class="next-overlay" role="dialog" aria-modal="true" aria-label="Moon Lander menu"></div>
      </div>
      <div class="next-command"><span>Rotate <kbd>←</kbd><kbd>→</kbd> · Thrust <kbd>Space</kbd> · Pause <kbd>Esc</kbd></span><a href="/game">stable flight deck</a><button data-next-action="pause">Ⅱ pause</button></div>
    </section>
  </main>
</Layout>

<script>
  import { mountLander } from '../scripts/lander-next';
  let cleanup: (() => void) | null = null;
  let bootId = 0;
  async function boot() {
    const root = document.querySelector<HTMLElement>('#lander-next-root');
    if (!root) return;
    cleanup?.(); cleanup = null;
    const currentBoot = ++bootId;
    const mounted = await mountLander(root);
    if (currentBoot !== bootId) mounted.destroy(); else cleanup = mounted.destroy;
  }
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', () => { bootId += 1; cleanup?.(); cleanup = null; });
</script>

<style is:global>
  .next-page { max-width: 1180px; margin: 0 auto; padding: 2rem 1rem 4rem; }
  .next-page-heading { margin-bottom: 1.2rem; }
  .next-page-heading h1 { margin: .55rem 0 .25rem; font: 600 clamp(2rem, 5vw, 3.4rem)/.95 "Space Grotesk Variable", sans-serif; letter-spacing: -.05em; }
  .next-page-heading h1 span { color: var(--color-muted); font-size: .55em; letter-spacing: 0; }
  .next-page-heading p { margin: 0; max-width: 42rem; color: var(--color-muted); font-size: 1rem; }
  .next-console { --paper: #f4ebda; --copper: #c97b3d; --signal: #d4eef1; --night: #101724; }
  .next-viewport { position: relative; width: 100%; height: min(68svh, 620px); min-height: 480px; overflow: hidden; background: var(--night); border: 1px solid #45515b; box-shadow: 0 24px 60px rgba(16,23,36,.28); }
  .next-viewport canvas { width: 100%; height: 100%; display: block; }
  .next-hud { position: absolute; inset: 1rem; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: .7rem; color: var(--paper); font: 600 .74rem/1.15 "JetBrains Mono Variable", monospace; letter-spacing: .08em; pointer-events: none; }
  .next-instrument, .next-vitals span { background: rgba(16,23,36,.78); border: 1px solid rgba(244,235,218,.28); box-shadow: inset 0 1px 0 rgba(255,255,255,.08); }
  .next-instrument { padding: .6rem .7rem; min-width: 6.4rem; }
  .next-instrument span, .next-instrument small { display: block; color: #b9c4c8; font-size: .65rem; }
  .next-instrument b { display: block; margin: .25rem 0; color: var(--paper); font-size: 1rem; }
  .next-instrument em { color: #d7e79d; font-style: normal; }
  .next-vitals { display: flex; justify-content: center; gap: .35rem; min-width: 0; }
  .next-vitals span { padding: .62rem .55rem; white-space: nowrap; color: #b9c4c8; }
  .next-vitals b { color: var(--paper); }
  .next-status { text-align: right; }
  .next-status b { color: #d7e79d; }
  .next-overlay { position: absolute; inset: 0; display: flex; padding: clamp(1rem, 4vw, 2.5rem); overflow: auto; background: linear-gradient(120deg, rgba(13,12,16,.22), rgba(13,12,16,.62) 48%, rgba(20,14,9,.84)); backdrop-filter: blur(2px); }
  .next-screen { width: min(100%, 43rem); margin: auto; padding: clamp(1.25rem, 4vw, 2.8rem); color: var(--paper); background: linear-gradient(145deg, rgba(27,29,35,.9), rgba(39,25,14,.88)); border: 1px solid rgba(255,231,186,.35); box-shadow: 0 16px 42px rgba(0,0,0,.32); }
  .next-kicker, .next-readout, .next-controls, .next-command { font: 600 .72rem/1.4 "JetBrains Mono Variable", monospace; letter-spacing: .08em; }
  .next-kicker { margin: 0; color: #d9a441; text-transform: uppercase; }
  .next-screen h1, .next-screen h2 { margin: .5rem 0 .65rem; color: #fff3db; font: 600 clamp(2rem, 7vw, 4.2rem)/.9 "Space Grotesk Variable", sans-serif; letter-spacing: -.05em; }
  .next-screen h2 { font-size: clamp(1.7rem, 5vw, 2.7rem); }
  .next-lede, .next-screen p, .next-screen li { color: #ded0b9; font-size: 1rem; line-height: 1.55; }
  .next-readout { display: grid; grid-template-columns: 1fr auto; gap: .55rem 1rem; margin: 1.3rem 0; padding: .8rem 0; border-top: 1px solid rgba(244,235,218,.22); border-bottom: 1px solid rgba(244,235,218,.22); color: #b9aa92; }
  .next-readout b { color: #d7e79d; text-align: right; }
  .next-actions { display: grid; gap: .6rem; margin-top: 1.2rem; }
  .next-primary, .next-secondary, .next-card { min-height: 3rem; padding: .8rem 1rem; border: 1px solid rgba(255,231,186,.35); cursor: pointer; font: 600 .8rem/1.2 "JetBrains Mono Variable", monospace; letter-spacing: .06em; text-align: left; }
  .next-primary { background: linear-gradient(100deg, #d58645, #d9a441); color: #24170c; text-align: center; }
  .next-secondary { background: rgba(16,23,36,.64); color: #e3d0ad; }
  .next-secondary span { float: right; color: #b9c4c8; font-size: .7rem; }
  .next-controls { margin: 1.4rem 0 0; color: #b9c4c8; text-align: center; }
  kbd { padding: .12rem .28rem; border: 1px solid rgba(244,235,218,.28); color: var(--paper); }
  .next-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: 1.2rem; }
  .next-card { display: grid; align-content: start; gap: .55rem; min-height: 12rem; background: rgba(16,23,36,.7); color: #ded0b9; }
  .next-card strong { color: #fff3db; font: 600 1rem/1.1 "Space Grotesk Variable", sans-serif; }
  .next-card small { margin-top: auto; color: #d7e79d; font-size: .72rem; line-height: 1.55; }
  .next-rarity { color: #d9a441; font-size: .68rem; text-transform: uppercase; }
  .next-inline { border: 0; background: transparent; color: #d7e79d; text-decoration: underline; cursor: pointer; }
  .next-touch { position: absolute; inset: auto 1rem 1rem; display: flex; justify-content: space-between; pointer-events: none; padding-bottom: env(safe-area-inset-bottom); }
  .next-touch button { width: 3.6rem; height: 3.6rem; border: 1px solid rgba(244,235,218,.35); border-radius: 50%; background: rgba(16,23,36,.7); color: var(--paper); pointer-events: auto; cursor: pointer; font-size: 1.5rem; touch-action: none; }
  .next-touch button:last-child { width: 4.5rem; height: 4.5rem; color: #24170c; background: #d9a441; }
  .next-command { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .7rem 1rem; padding: .75rem .1rem; color: var(--color-muted); }
  .next-command a, .next-command button { border: 0; background: transparent; color: inherit; cursor: pointer; font: inherit; text-decoration: none; }
  @media (pointer: fine) and (hover: hover) { .next-touch { display: none; } }
  @media (pointer: fine) and (hover: hover) and (any-pointer: coarse) { .next-touch { display: flex; } }
  @media (max-width: 700px) { .next-page { max-width: none; margin-inline: -1.5rem; padding: 0 0 3rem; } .next-page-heading { display: none; } .next-viewport { height: max(470px, min(650px, calc(100svh - 120px))); min-height: 0; border-inline: 0; } .next-hud { inset: .65rem; grid-template-columns: 1fr auto; align-content: start; } .next-vitals { grid-column: 1 / -1; grid-row: 2; justify-content: stretch; overflow: hidden; } .next-vitals span { flex: 1; padding: .45rem .3rem; font-size: .62rem; } .next-status { grid-column: 2; grid-row: 1; } .next-instrument { min-width: auto; } .next-cards { grid-template-columns: 1fr; } .next-card { min-height: 8rem; } .next-command { padding-inline: .75rem; } }
  @media (prefers-reduced-motion: reduce) { .next-overlay { backdrop-filter: none; } }
</style>

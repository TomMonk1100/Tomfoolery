---
import Layout from '../layouts/Layout.astro';
import FamilyBranch from '../components/FamilyBranch.astro';
import FamilyMap from '../components/FamilyMap.astro';
import { familyBranch, people, relationships, personById, sourceById, sources } from '../data/family';
import '../styles/family.css';
---
<Layout title="Family history — Tomfoolery" description="An evolving Muncie and Mangini family tree, with sources, alternate names, and room for unanswered questions." noindex>
  <article class="editorial-page family-page" data-family-root>
    <header class="family-lead">
      <span class="editorial-kicker">The family notebook · Muncie / Mangini</span>
      <h1>One family. Many names.</h1>
      <p>Explore the connections from Ohio to Italy. Zoom out for the whole picture, or choose a person to follow their story.</p>
    </header>
    <FamilyMap />
    <details class="family-fallback">
      <summary>Read the branches as a list</summary>
      <FamilyBranch branch={familyBranch} />
    </details>
    <div class="family-profile-home" data-profile-home>
      <section id="family-profiles" class="family-profiles" aria-labelledby="profiles-heading">
        <div class="family-detail-header"><h2 id="profiles-heading">Person notes</h2><button type="button" data-close-profile aria-label="Close person details" hidden>×</button></div>
        <button class="family-locate" type="button" data-locate-person hidden>Locate in tree ↗</button>
        <noscript><p>All profiles are available below. The branches work without JavaScript.</p></noscript>
        {people.map(person => {
          const relations = relationships.filter(r => r.from === person.id || r.to === person.id);
          const citations = [...new Set([...person.facts.flatMap(f => f.sources), ...relations.flatMap(r => r.sources)])];
          return <article id={`person-${person.id}`} class="family-profile" data-profile={person.id} data-older-profile={person.provisional || undefined}>
            <span class="editorial-kicker">Research profile {person.provisional && '· provisional branch'}</span>
            <h3 tabindex="-1">{person.name}</h3>
            <p class="family-aliases">{person.aliases.length ? `Also recorded or searched as: ${person.aliases.join(' · ')}` : 'No alternate name recorded yet.'}</p>
            <dl class="family-facts">{person.facts.map(fact => <div>
              <dt>{fact.label} <span class="family-confidence" data-confidence={fact.confidence}>{fact.confidence}</span></dt>
              <dd>{fact.value}{fact.note && <small>{fact.note}</small>}
                <span class="family-fact-sources">{fact.sources.map(id => <a href={`#source-${id}`}>{sourceById[id].kind} ↗</a>)}</span>
              </dd>
            </div>)}</dl>
            <details class="family-person-section"><summary>Research notes</summary><ul class="family-notes">{person.notes.map(note => <li>{note}</li>)}</ul></details>
            {relations.length > 0 && <details class="family-person-section"><summary>Connections & evidence</summary><ul class="family-profile-relations">{relations.map(r => {
              const other = r.from === person.id ? r.to : r.from;
              const label = r.kind === 'parent' ? (r.from === person.id ? 'Child' : 'Parent') : r.kind === 'spouse' ? 'Spouse / working couple' : 'Sibling';
              return <li data-confidence={r.confidence}><span class="family-confidence">{r.confidence}</span> {label}: <a href={`#person-${other}`} data-person-link={other}>{personById[other].name}</a><small>{r.note}</small><span class="family-fact-sources">{r.sources.map(id => <a href={`#source-${id}`}>{sourceById[id].kind} ↗</a>)}</span></li>;
            })}</ul></details>}
            <details class="family-person-section"><summary>Sources for this person</summary><ul class="family-notes">{citations.map(id => <li><a href={`#source-${id}`}>{sourceById[id].title}</a> <small>· {sourceById[id].kind}</small></li>)}</ul></details>
            <a class="family-back" href="#tree-heading">Back to tree ↑</a>
          </article>;
        })}
      </section>
    </div>
    <details class="family-research"><summary id="research-heading">Research notes & next steps</summary>
      <p class="family-research-intro">Palmiero’s 1927 certificate names Concezio Mangini and Carlina. Emma’s 1945 certificate names Nicola Richiuto and Dominica Mastrocco. Those records guide the next searches; the original Italian acts are still needed.</p>
      <ol>
        <li><strong>Corroborate the parents named on Palmiero’s death certificate.</strong> Certificate 40647 names Concezio Mangini and Carlina, both born in Italy. Seek Palmiero’s Italian birth act around 3 April 1851 to confirm those reported names and identify the comune. The certificate gives only Italy. <a href="https://www.familysearch.org/ark:/61903/3:1:33S7-9PK4-DJR">Open certificate ↗</a></li>
        <li><strong>Reconstruct the 1900, 1910, and 1920 households.</strong> Compare Muncie, Muncy, Muncey, and Mangini, with Emma / Emida and the candidate children. Record household members, immigration years, naturalization status, residence, and the image citation. No matching household has been inspected here.</li>
        <li><strong>Follow both surnames through immigration and naturalization.</strong> Search Paul / Palmier / Palmiero / Palmiro / Palmerio and the spouse’s variants. A petition or passenger list may identify the Italian comune. <a href="https://www.familysearch.org/en/search/collection/1987615">Ohio naturalizations ↗</a></li>
        <li><strong>Follow Emma’s newly reported birthplace.</strong> Seek her 5 August 1875 Castel di Sangro birth act to corroborate Nicola Richiuto and Dominica Mastrocco and establish their match to the 1856 couple. Antenati’s available birth-register results for this locality end in 1865; later records need another access route. <a href="https://www.familysearch.org/ark:/61903/3:1:S3HT-6QZ7-SQP">Emma’s certificate ↗</a></li>
        <li><strong>Resolve the marriage and Palmiero’s birthplace.</strong> Search both Italy and Franklin County around 1895. June 30 remains an inferred date only. Seek Maria’s reported 1897 birth and Nicola / Domenica’s 1856 original marriage act. Emma’s Castel di Sangro birthplace does not establish Palmiero’s town.</li>
        <li><strong>Check Nora’s original obituary.</strong> The reproduced text points to the Columbus Dispatch, February 12, 1962, page 4A; the compiled citation instead says November 9, 1989. Preserve both until the newspaper is inspected.</li>
      </ol>
    </details>
    <details class="family-sources"><summary id="sources-heading">Sources & their limits</summary>
      <p>Original records, official indexes, transcriptions, compiled genealogies, supplied information, and inferences are recorded separately. A collection or access guide is not evidence of a matching person.</p>
      <ul>{sources.map(source => <li id={`source-${source.id}`}><span class="editorial-kicker">{source.kind}</span><h3>{source.title}</h3><p>{source.citation}</p>{source.url && <a href={source.url}>Visit source ↗</a>}</li>)}</ul>
    </details>
  </article>
  <script>
    import '../scripts/family-tree';
  </script>
</Layout>
